{
  "manifest_version": 3,
  "name": "Zacro owned tab capture acceptance",
  "version": "1.0.0",
  "permissions": ["tabs", "tabCapture", "activeTab", "scripting", "offscreen"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "Grant capture for the selected owned tab"}
}

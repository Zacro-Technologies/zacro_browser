{
  "manifest_version": 3,
  "name": "Zacro Extension UI Probe",
  "version": "1.0.0",
  "description": "Local-only extension UI and persisted worker diagnostic.",
  "permissions": ["activeTab", "storage"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "Zacro Extension UI Probe", "default_popup": "popup.html"},
  "content_scripts": [{"matches": ["http://127.0.0.1/*"], "js": ["content.js"]}]
}

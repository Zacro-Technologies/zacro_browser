{
  "manifest_version": 3,
  "name": "Zacro Native Integration Fixture",
  "version": "1.0.0",
  "description": "Disposable local acceptance fixture for Zacro's native Chromium integration.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "scripting",
    "activeTab",
    "offscreen",
    "sidePanel",
    "debugger",
    "history",
    "bookmarks",
    "sessions",
    "downloads",
    "identity",
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Record native action"
  },
  "commands": {
    "record-native-shortcut": {
      "suggested_key": { "mac": "Command+Shift+Y" },
      "description": "Record a native shell shortcut"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}

+#import <AppKit/AppKit.h>
+
+#include "chrome/browser/ui/views/extensions/native_extension_popup_anchor.h"
+
+#include <utility>
+#include <vector>
+#include <cmath>
+#include "base/command_line.h"
+#include "base/functional/callback.h"
+#include "base/supports_user_data.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/mac/coordinate_conversion.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+constexpr char kPendingAnchor[] = "zacro.native.extension-popup-anchor";
+struct PendingAnchor : base::SupportsUserData::Data {
+  PendingAnchor(NSWindow* window, const gfx::Rect& bounds)
+      : owner(window), bounds(bounds), expires(base::TimeTicks::Now() + base::Seconds(5)) {}
+  __weak NSWindow* owner;
+  gfx::Rect bounds;
+  base::TimeTicks expires;
+  bool valid() const {
+    return owner && owner.visible && !owner.miniaturized && base::TimeTicks::Now() <= expires;
+  }
+};
+bool Descendant(NSWindow* window, NSWindow* ancestor) {
+  if (!ancestor) return false;
+  for (NSWindow* current = window; current; current = current.parentWindow) {
+    if (current == ancestor) return true;
+  }
+  return false;
+}
+struct PopupState {
+  __weak NSWindow* owner;
+  __weak NSWindow* popup;
+  base::RepeatingClosure close;
+  void Close(const char* reason, NSWindow* trigger = nil) {
+    const auto* command = base::CommandLine::ForCurrentProcess();
+    if (command->HasSwitch("engine-acceptance") &&
+        command->HasSwitch("native-integration-acceptance")) {
+      NSLog(@"Native action popup close request reason=%s popup=%ld owner=%ld trigger=%ld key=%ld active=%d visible=%d",
+            reason, (long)(popup ? popup.windowNumber : -1),
+            (long)(owner ? owner.windowNumber : -1),
+            (long)(trigger ? trigger.windowNumber : -1),
+            (long)(NSApp.keyWindow ? NSApp.keyWindow.windowNumber : -1),
+            NSApp.active, popup.visible);
+    }
+    // Closing the bubble can synchronously destroy its anchor and reset the
+    // stored callback. Keep this invocation's bind state alive until it returns.
+    auto callback = close;
+    if (callback) callback.Run();
+  }
+};
+}  // namespace
+
+class NativeExtensionPopupAnchor::Impl {
+ public:
+  Impl(NSWindow* owner, const gfx::Rect& bounds) : state_(std::make_shared<PopupState>()) {
+    state_->owner = owner;
+    widget_ = std::make_unique<views::Widget>();
+    views::Widget::InitParams params(views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+                                    views::Widget::InitParams::TYPE_POPUP);
+    params.name = "ZacroExtensionPopupAnchor";
+    params.bounds = bounds;
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.activatable = views::Widget::InitParams::Activatable::kNo;
+    params.accept_events = false;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+    widget_->Init(std::move(params));
+    widget_->SetContentsView(std::make_unique<views::View>());
+    NSWindow* anchor = widget_->GetNativeWindow().GetNativeNSWindow();
+    anchor.opaque = NO; anchor.backgroundColor = NSColor.clearColor;
+    anchor.hasShadow = NO; anchor.ignoresMouseEvents = YES;
+    // NativeWidgetMac only recognizes Views parents. The native shell is an
+    // ordinary NSWindow, so attach its child explicitly without showing the
+    // hidden Chrome document or changing its active WebContents.
+    [owner addChildWindow:anchor ordered:NSWindowAbove];
+    widget_->ShowInactive();
+  }
+  ~Impl() {
+    state_->close.Reset();
+    NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+    for (id observer : observers_) [center removeObserver:observer];
+    if (monitor_) [NSEvent removeMonitor:monitor_];
+    if (NSWindow* popup = state_->popup) {
+      // The notification is synchronous; the shell retains only weak window
+      // identities and cannot mistake an OAuth dialog for an action popup.
+      [center postNotificationName:@"ZacroNativeExtensionPopupClosed"
+                            object:popup];
+    }
+    NSWindow* anchor = widget_->GetNativeWindow().GetNativeNSWindow();
+    [anchor.parentWindow removeChildWindow:anchor];
+    // The owning bubble may be destroying its widget. Release the anchor on
+    // the next UI turn, after BubbleDialogDelegate removes its observations.
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, std::move(widget_));
+  }
+  views::View* view() const { return widget_->GetContentsView(); }
+  void Attach(views::Widget* popup, base::RepeatingClosure close) {
+    // The Swift shell's command palette uses a floating native panel. Keep
+    // this genuine, owner-authorized action popup above that panel, while
+    // native menus and modal sheets retain their higher system ordering.
+    popup->SetZOrderLevel(ui::ZOrderLevel::kFloatingWindow);
+    state_->popup = popup->GetNativeWindow().GetNativeNSWindow();
+    state_->close = std::move(close);
+    std::weak_ptr<PopupState> weak = state_;
+    NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+    for (NSNotificationName name in @[NSWindowWillCloseNotification,
+                                    NSWindowWillMiniaturizeNotification,
+                                    NSWindowDidResizeNotification]) {
+      observers_.push_back([center addObserverForName:name object:state_->owner queue:nil
+          usingBlock:^(NSNotification* event) {
+            if (auto state = weak.lock()) state->Close(event.name.UTF8String, event.object);
+          }]);
+    }
+    observers_.push_back([center addObserverForName:NSApplicationDidResignActiveNotification object:NSApp queue:nil
+        usingBlock:^(NSNotification*) {
+          if (auto state = weak.lock()) state->Close("application-resigned-active");
+        }]);
+    observers_.push_back([center addObserverForName:NSWindowDidBecomeKeyNotification object:nil queue:nil
+        usingBlock:^(NSNotification* event) {
+          if (auto state = weak.lock(); state && state->popup.visible && !Descendant(event.object, state->popup))
+            state->Close("other-window-became-key", event.object);
+        }]);
+    monitor_ = [NSEvent addLocalMonitorForEventsMatchingMask:
+        NSEventMaskLeftMouseDown | NSEventMaskRightMouseDown | NSEventMaskOtherMouseDown
+        handler:^NSEvent*(NSEvent* event) {
+          if (auto state = weak.lock(); state && !Descendant(event.window, state->popup)) {
+            // Keep native menus usable. The popup's existing close routine also
+            // preserves its DevTools and JavaScript-dialog exceptions.
+            if (!event.window || event.window.level < NSPopUpMenuWindowLevel)
+              state->Close("outside-mouse-down", event.window);
+          }
+          return event;
+        }];
+    NSWindow* owner = state_->owner;
+    NSWindow* native_popup = state_->popup;
+    if (owner && native_popup) {
+      // Post last: a native observer may synchronously close the popup, which
+      // destroys this anchor. Neither the C++ state nor observers own NSWindows.
+      [center postNotificationName:@"ZacroNativeExtensionPopupOpened"
+                            object:native_popup userInfo:@{@"ownerWindow": owner}];
+    }
+  }
+ private:
+  std::shared_ptr<PopupState> state_;
+  std::unique_ptr<views::Widget> widget_;
+  std::vector<__strong id> observers_;
+  __strong id monitor_ = nil;
+};
+
+NativeExtensionPopupAnchor::NativeExtensionPopupAnchor(std::unique_ptr<Impl> impl) : impl_(std::move(impl)) {}
+NativeExtensionPopupAnchor::~NativeExtensionPopupAnchor() = default;
+views::View* NativeExtensionPopupAnchor::view() const { return impl_->view(); }
+void NativeExtensionPopupAnchor::Attach(views::Widget* popup, base::RepeatingClosure close) {
+  impl_->Attach(popup, std::move(close));
+}
+bool NativeExtensionPopupAnchor::Prepare(content::WebContents* contents,
+                                       int native_window_number,
+                                       const gfx::RectF& cocoa_screen_anchor) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  CancelPrepared(contents);
+  if (!contents || native_window_number <= 0 || cocoa_screen_anchor.IsEmpty() ||
+      !std::isfinite(cocoa_screen_anchor.x()) || !std::isfinite(cocoa_screen_anchor.y()) ||
+      !std::isfinite(cocoa_screen_anchor.width()) || !std::isfinite(cocoa_screen_anchor.height()) ||
+      cocoa_screen_anchor.width() > 512 || cocoa_screen_anchor.height() > 512) return false;
+  NSWindow* owner = [NSApp windowWithWindowNumber:native_window_number];
+  const NSRect native_rect = NSMakeRect(cocoa_screen_anchor.x(), cocoa_screen_anchor.y(),
+      cocoa_screen_anchor.width(), cocoa_screen_anchor.height());
+  if (!owner || !owner.visible || owner.miniaturized ||
+      !NSContainsRect(owner.frame, native_rect)) return false;
+  contents->SetUserData(kPendingAnchor, std::make_unique<PendingAnchor>(owner, gfx::ScreenRectFromNSRect(native_rect)));
+  return true;
+}
+bool NativeExtensionPopupAnchor::HasPrepared(content::WebContents* contents) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto* pending = contents ? static_cast<PendingAnchor*>(contents->GetUserData(kPendingAnchor)) : nullptr;
+  return pending && pending->valid();
+}
+bool NativeExtensionPopupAnchor::IsPreparedOwnerActive(content::WebContents* contents) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto* pending = contents ? static_cast<PendingAnchor*>(contents->GetUserData(kPendingAnchor)) : nullptr;
+  return pending && pending->valid() && NSApp.active && !NSApp.hidden &&
+         !NSApp.modalWindow && !pending->owner.attachedSheet && !NSApp.keyWindow.sheetParent &&
+         Descendant(NSApp.keyWindow, pending->owner);
+}
+void NativeExtensionPopupAnchor::CancelPrepared(content::WebContents* contents) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (contents) contents->RemoveUserData(kPendingAnchor);
+}
+std::unique_ptr<NativeExtensionPopupAnchor> NativeExtensionPopupAnchor::Take(content::WebContents* contents) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto* pending = contents ? static_cast<PendingAnchor*>(contents->GetUserData(kPendingAnchor)) : nullptr;
+  if (!pending) return nullptr;
+  NSWindow* owner = pending->valid() ? pending->owner : nil;
+  const gfx::Rect bounds = pending->bounds;
+  contents->RemoveUserData(kPendingAnchor);
+  if (!owner) return nullptr;
+  return std::unique_ptr<NativeExtensionPopupAnchor>(
+      new NativeExtensionPopupAnchor(std::make_unique<Impl>(owner, bounds)));
+}

+void ExtensionPopup::OnNativeBrowserDidClose(BrowserWindowInterface* browser) {
+  if (!native_anchor_ || browser_ != browser) {
+    return;
+  }
+
+  // This callback runs only after close has been accepted, before Browser is
+  // deleted. The native shell anchor is outside its Widget tree, so deferred
+  // bubble destruction alone cannot bound ExtensionViewHost's Browser delegate.
+  native_browser_close_subscription_ = {};
+  deferred_close_weak_ptr_factory_.InvalidateWeakPtrs();
+  auto weak_this = deferred_close_weak_ptr_factory_.GetWeakPtr();
+  Observe(nullptr);
+  anchor_widget_observation_.Reset();
+  extension_registry_observation_.Reset();
+  security_dialog_tracker_observation_.Reset();
+  withheld_from_view_.reset();
+  browser_->GetTabStripModel()->RemoveObserver(this);
+  browser_ = nullptr;
+  auto shown_callback = std::move(shown_callback_);
+
+  // Match OnExtensionUnloaded: destroy the view first so it cannot message the
+  // host while the macOS Widget closes asynchronously. Host destruction also
+  // notifies the original action delegate while its Browser is still alive.
+  if (extension_view_) {
+    RemoveChildViewT(extension_view_.ExtractAsDangling());
+  }
+  if (weak_this) {
+    weak_this->host_.reset();
+  }
+  if (weak_this) {
+    weak_this->CloseDeferredIfNecessary();
+  }
+  // A popup that never finished loading still completes exactly once. The
+  // callback is external and may destroy the popup; do not access this after it.
+  if (shown_callback) {
+    std::move(shown_callback).Run(nullptr);
+  }
+}

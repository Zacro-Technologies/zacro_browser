+namespace {
+void TraceNativeHost(const char* stage, content::RenderFrameHost* frame = nullptr,
+                     int disposition = -1, int browser = 0, int window = 0,
+                     int requested_process = -1, int requested_frame = -1) {
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  if (!command->HasSwitch("engine-acceptance") ||
+      !command->HasSwitch("native-integration-acceptance")) return;
+  LOG(ERROR) << "Native extension-host stage=" << stage
+             << " process=" << (frame ? frame->GetProcess()->GetDeprecatedID() : -1)
+             << " frame=" << (frame ? frame->GetRoutingID() : -1)
+             << " disposition=" << disposition << " browser=" << browser
+             << " window=" << window << " requested_process=" << requested_process
+             << " requested_frame=" << requested_frame;
+}
+auto& HostOwnerResolver() {
+  static base::NoDestructor<ZacroExtensionHostOwnerResolver> value;
+  return *value;
+}
+auto& HostNavigationCallbacks() {
+  static constinit ccef_extension_host_navigation_callbacks_t value{};
+  return value;
+}
+bool ManagedContext(content::BrowserContext* context) {
+  return context && CefBrowserContext::FromProfile(Profile::FromBrowserContext(context));
+}
+std::optional<ZacroExtensionHostOwner> ResolveHostOwner(content::RenderFrameHost* frame) {
+  if (!frame || !frame->IsRenderFrameLive() || !HostOwnerResolver()) {
+    TraceNativeHost(!frame ? "resolve-no-frame" : !frame->IsRenderFrameLive()
+        ? "resolve-frame-not-live" : "resolve-no-owner-resolver", frame);
+    return std::nullopt;
+  }
+  auto owner = HostOwnerResolver().Run(frame);
+  if (!owner || !owner->browser || owner->logical_window_id <= 0 || owner->extension_id.size() != 32 ||
+      owner->browser->IsAlloyStyle() || !owner->browser->IsValid() ||
+      !owner->browser->GetWebContents() ||
+      owner->browser->GetWebContents()->GetBrowserContext() != frame->GetBrowserContext()) {
+    TraceNativeHost(!owner ? "resolve-authority-rejected" : !owner->browser ? "resolve-no-browser"
+        : owner->logical_window_id <= 0 ? "resolve-invalid-window"
+        : owner->extension_id.size() != 32 ? "resolve-invalid-extension"
+        : owner->browser->IsAlloyStyle() ? "resolve-alloy-browser"
+        : !owner->browser->IsValid() ? "resolve-invalid-browser"
+        : !owner->browser->GetWebContents() ? "resolve-browser-without-contents"
+        : "resolve-browser-profile-mismatch", frame);
+    return std::nullopt;
+  }
+  TraceNativeHost("resolve-accepted", frame, -1, owner->browser->GetIdentifier(), owner->logical_window_id);
+  return owner;
+}
+NO_SANITIZE("cfi-icall") void AbortNativeHostPopup(CefRefPtr<CefClient> client, int popup_id) {
+  const auto callback = HostNavigationCallbacks().aborted;
+  if (!client || !callback) return;
+  void* original = ZacroUnwrapExtensionHostClient(client);
+  callback(original, popup_id);
+  ZacroReleaseExtensionHostClient(original);
+}

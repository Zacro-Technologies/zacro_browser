namespace {
void TraceNativeHost(const char* stage, content::RenderFrameHost* frame = nullptr,
                     int disposition = -1, int browser = 0, int window = 0,
                     int requested_process = -1, int requested_frame = -1) {
  const auto* command = base::CommandLine::ForCurrentProcess();
  if (!command->HasSwitch("engine-acceptance") ||
      !command->HasSwitch("native-integration-acceptance")) return;
  LOG(ERROR) << "Native extension-host stage=" << stage
             << " process=" << (frame ? frame->GetProcess()->GetDeprecatedID() : -1)
             << " frame=" << (frame ? frame->GetRoutingID() : -1)
             << " disposition=" << disposition << " browser=" << browser
             << " window=" << window << " requested_process=" << requested_process
             << " requested_frame=" << requested_frame;
}
auto& HostOwnerResolver() {
  static base::NoDestructor<ZacroExtensionHostOwnerResolver> value;
  return *value;
}
auto& HostNavigationCallbacks() {
  static constinit ccef_extension_host_navigation_callbacks_t value{};
  return value;
}
bool ManagedContext(content::BrowserContext* context) {
  return context && CefBrowserContext::FromProfile(Profile::FromBrowserContext(context));
}
std::optional<ZacroExtensionHostOwner> ResolveHostOwner(content::RenderFrameHost* frame) {
  if (!frame || !frame->IsRenderFrameLive() || !HostOwnerResolver()) {
    TraceNativeHost(!frame ? "resolve-no-frame" : !frame->IsRenderFrameLive()
        ? "resolve-frame-not-live" : "resolve-no-owner-resolver", frame);
    return std::nullopt;
  }
  auto owner = HostOwnerResolver().Run(frame);
  if (!owner || !owner->browser || owner->logical_window_id <= 0 || owner->extension_id.size() != 32 ||
      owner->browser->IsAlloyStyle() || !owner->browser->IsValid() ||
      !owner->browser->GetWebContents() ||
      owner->browser->GetWebContents()->GetBrowserContext() != frame->GetBrowserContext()) {
    TraceNativeHost(!owner ? "resolve-authority-rejected" : !owner->browser ? "resolve-no-browser"
        : owner->logical_window_id <= 0 ? "resolve-invalid-window"
        : owner->extension_id.size() != 32 ? "resolve-invalid-extension"
        : owner->browser->IsAlloyStyle() ? "resolve-alloy-browser"
        : !owner->browser->IsValid() ? "resolve-invalid-browser"
        : !owner->browser->GetWebContents() ? "resolve-browser-without-contents"
        : "resolve-browser-profile-mismatch", frame);
    return std::nullopt;
  }
  TraceNativeHost("resolve-accepted", frame, -1, owner->browser->GetIdentifier(), owner->logical_window_id);
  return owner;
}
NO_SANITIZE("cfi-icall") void AbortNativeHostPopup(CefRefPtr<CefClient> client, int popup_id) {
  const auto callback = HostNavigationCallbacks().aborted;
  if (!client || !callback) return;
  void* original = ZacroUnwrapExtensionHostClient(client);
  callback(original, popup_id);
  ZacroReleaseExtensionHostClient(original);
}
}  // namespace

extern "C" CEF_EXPORT int cef_zacro_extension_host_navigation_v1(
    const ccef_extension_host_navigation_callbacks_t* callbacks) {
  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
  if (!callbacks || callbacks->size != sizeof(*callbacks) || callbacks->reserved ||
      !callbacks->prepare || !callbacks->aborted) return 0;
  HostNavigationCallbacks() = *callbacks;
  return 1;
}

NO_SANITIZE("cfi-icall") bool CefBrowserInfoManager::PrepareNativeExtensionHostPopup(
    content::RenderFrameHost* opener, const GURL& target_url,
    const std::string& frame_name, WindowOpenDisposition disposition,
    const blink::mojom::WindowFeatures& features, bool user_gesture) {
  CEF_REQUIRE_UIT();
  TraceNativeHost("prepare-enter", opener, static_cast<int>(disposition));
  auto owner = ResolveHostOwner(opener);
  const auto callback = HostNavigationCallbacks().prepare;
  if (!owner || !callback || target_url.spec().size() > 8192 || frame_name.size() > 1024 ||
      (disposition != WindowOpenDisposition::NEW_FOREGROUND_TAB &&
       disposition != WindowOpenDisposition::NEW_BACKGROUND_TAB &&
       disposition != WindowOpenDisposition::NEW_POPUP &&
       disposition != WindowOpenDisposition::NEW_WINDOW &&
       disposition != WindowOpenDisposition::SINGLETON_TAB)) {
    TraceNativeHost(!owner ? "prepare-no-owner" : !callback ? "prepare-no-callback"
        : target_url.spec().size() > 8192 ? "prepare-url-too-long"
        : frame_name.size() > 1024 ? "prepare-name-too-long" : "prepare-disposition-rejected",
        opener, static_cast<int>(disposition));
    return false;
  }
  const auto source_document = opener->GetWeakDocumentPtr();
  auto client = owner->browser->GetClient();
  if (!client) { TraceNativeHost("prepare-no-native-client", opener); return false; }
  auto pending = std::make_unique<PendingPopup>();
  pending->step = PendingPopup::CAN_CREATE_WINDOW;
  pending->alloy_style = false;
  pending->opener_global_id = opener->GetGlobalId();
  pending->native_host_document = source_document;
  pending->native_host_owner_browser = owner->browser->GetIdentifier();
  pending->native_host_owner_window = owner->logical_window_id;
  pending->native_host_extension = owner->extension_id;
  pending->target_url = target_url;
  pending->target_frame_name = frame_name;
  pending->settings = owner->browser->settings();
  const int popup_id = owner->browser->GetNextPopupId();
  ccef_extension_host_navigation_request_t request{};
  request.size = sizeof(request);
  request.popup_id = popup_id;
  request.disposition = static_cast<int>(disposition);
  request.user_gesture = user_gesture;
  request.owner_window_id = owner->logical_window_id;
  request.x = features.bounds.x(); request.y = features.bounds.y();
  request.width = features.bounds.width(); request.height = features.bounds.height();
  request.feature_flags = (features.has_x ? 1 : 0) | (features.has_y ? 2 : 0) |
      (features.has_width ? 4 : 0) | (features.has_height ? 8 : 0) | (features.is_popup ? 16 : 0);
  request.target_url = target_url.spec().c_str();
  request.frame_name = frame_name.c_str();
  request.source_extension_id = owner->extension_id.c_str();
  void* original = ZacroUnwrapExtensionHostClient(client);
  void* replacement = nullptr;
  const int accepted = callback(original, &request, &replacement);
  ZacroReleaseExtensionHostClient(original);
  if (accepted != 1 || !replacement) {
    TraceNativeHost("prepare-swift-rejected", opener, static_cast<int>(disposition),
        owner->browser->GetIdentifier(), owner->logical_window_id);
    ZacroReleaseExtensionHostClient(replacement);
    return false;
  }
  pending->client = ZacroWrapExtensionHostClient(replacement);
  pending->aborted_callback = base::BindOnce(&AbortNativeHostPopup, client, popup_id);
  const auto current = ResolveHostOwner(source_document.AsRenderFrameHostIfValid());
  if (!current || current->browser->GetIdentifier() != pending->native_host_owner_browser ||
      current->logical_window_id != pending->native_host_owner_window ||
      current->extension_id != pending->native_host_extension) {
    TraceNativeHost("prepare-owner-changed-after-swift", opener); return false;
  }
  CefBrowserCreateParams params;
  params.popup_with_views_hosted_opener = true;
  params.settings = pending->settings;
  params.client = pending->client;
  pending->platform_delegate = CefBrowserPlatformDelegate::Create(params);
  if (!pending->platform_delegate || !pending->platform_delegate->IsChromeStyle()) {
    TraceNativeHost("prepare-platform-delegate-rejected", opener); return false;
  }
  opener->GetProcess()->FilterURL(false, &pending->target_url);
  pending_create_popup_ = pending.get();
  PushPendingPopup(std::move(pending));
  TraceNativeHost("prepare-accepted", opener, static_cast<int>(disposition));
  return true;
}

void CefBrowserInfoManager::NativeExtensionHostWebContentsCreated(
    extensions::ExtensionHost* source_host, content::WebContents* source,
    const content::GlobalRenderFrameHostId& opener_id, const GURL& target_url,
    content::WebContents* created) {
  CEF_REQUIRE_UIT();
  if (!source_host || !source || source_host->host_contents() != source || !ManagedContext(source->GetBrowserContext())) {
    TraceNativeHost("created-source-rejected"); return;
  }
  auto pending = PopPendingPopup(PendingPopup::GET_CUSTOM_WEB_CONTENTS_VIEW,
      PendingPopup::CAN_CREATE_WINDOW, opener_id, target_url);
  if (!pending) { TraceNativeHost("created-no-pending"); return; }
  if (pending_create_popup_ == pending.get()) pending_create_popup_ = nullptr;
  auto* frame = pending->native_host_document.AsRenderFrameHostIfValid();
  const auto owner = ResolveHostOwner(frame);
  if (!owner || !created || created->GetBrowserContext() != source->GetBrowserContext() ||
      content::WebContents::FromRenderFrameHost(frame) != source || frame->GetGlobalId() != opener_id ||
      owner->browser->GetIdentifier() != pending->native_host_owner_browser ||
      owner->logical_window_id != pending->native_host_owner_window ||
      owner->extension_id != pending->native_host_extension) {
    TraceNativeHost("created-ownership-rejected", frame); return;
  }
  if (!NativeHistoryOwner::RegisterProvisionalExtensionPopup(frame, owner->logical_window_id, created)) {
    TraceNativeHost("created-history-owner-rejected", frame); return;
  }
  ChromeBrowserDelegate::CreateBrowserHostForPopup(created, pending->settings, pending->client,
      pending->extra_info, std::move(pending->platform_delegate), false, owner->browser);
  pending->step = PendingPopup::WEB_CONTENTS_CREATED;
  pending->new_contents = created;
  PushPendingPopup(std::move(pending));
  TraceNativeHost("created-accepted");
}

bool CefBrowserInfoManager::AddNativeExtensionHostContents(extensions::ExtensionHost* source_host,
    content::WebContents* source, std::unique_ptr<content::WebContents>& created) {
  CEF_REQUIRE_UIT();
  if (!source || !ManagedContext(source->GetBrowserContext())) {
    TraceNativeHost("add-source-unmanaged"); return false;
  }
  if (!created) { TraceNativeHost("add-no-created-contents"); return true; }
  auto pending = PopPendingPopup(PendingPopup::WEB_CONTENTS_CREATED,
      PendingPopup::WEB_CONTENTS_CREATED, created.get());
  auto* frame = pending ? pending->native_host_document.AsRenderFrameHostIfValid() : nullptr;
  const auto owner = ResolveHostOwner(frame);
  const auto child = ChromeBrowserHostImpl::GetBrowserForContents(created.get());
  if (!source_host || source_host->host_contents() != source || !pending || !owner || !child ||
      created->GetBrowserContext() != source->GetBrowserContext() ||
      content::WebContents::FromRenderFrameHost(frame) != source ||
      owner->browser->GetIdentifier() != pending->native_host_owner_browser ||
      owner->logical_window_id != pending->native_host_owner_window ||
      owner->extension_id != pending->native_host_extension) {
    TraceNativeHost("add-ownership-rejected", frame); created.reset(); return true;
  }
  child->AddNewContents(std::move(created), std::nullopt);
  pending->step = PendingPopup::CREATION_COMPLETE;
  TraceNativeHost("add-accepted");
  return true;
}

bool CefBrowserInfoManager::OpenNativeExtensionHostURL(extensions::ExtensionHost* source_host,
    const content::OpenURLParams& params,
    base::OnceCallback<void(content::NavigationHandle&)>& callback,
    content::WebContents** result) {
  CEF_REQUIRE_UIT();
  TraceNativeHost("open-url-enter", nullptr, static_cast<int>(params.disposition), 0, 0,
      params.source_render_process_id, params.source_render_frame_id);
  if (!source_host || !ManagedContext(source_host->browser_context())) {
    TraceNativeHost("open-url-unmanaged-host"); return false;
  }
  if (!result) { TraceNativeHost("open-url-no-result-receiver"); return true; }
  *result = nullptr;
  if (params.disposition == WindowOpenDisposition::SAVE_TO_DISK) {
    TraceNativeHost("open-url-save-to-disk"); return false;
  }
  auto* frame = content::RenderFrameHost::FromID(params.source_render_process_id, params.source_render_frame_id);
  if (!frame || content::WebContents::FromRenderFrameHost(frame) != source_host->host_contents()) {
    TraceNativeHost(!frame ? "open-url-source-frame-missing" : "open-url-source-host-mismatch", frame);
    return true;
  }
  const blink::mojom::WindowFeatures features;
  if (!PrepareNativeExtensionHostPopup(frame, params.url, "", params.disposition, features, params.user_gesture)) {
    TraceNativeHost("open-url-prepare-rejected", frame, static_cast<int>(params.disposition)); return true;
  }
  content::WebContents::CreateParams create(source_host->browser_context(), params.source_site_instance);
  create.initially_hidden = true;
  auto contents = content::WebContents::Create(create);
  auto* raw = contents.get();
  const auto alive = raw->GetWeakPtr();
  NativeExtensionHostWebContentsCreated(source_host, source_host->host_contents(), frame->GetGlobalId(), params.url, raw);
  if (!AddNativeExtensionHostContents(source_host, source_host->host_contents(), contents) || contents) {
    TraceNativeHost("open-url-add-rejected", frame); return true;
  }
  if (!alive || !ChromeBrowserHostImpl::GetBrowserForContents(alive.get())) {
    TraceNativeHost("open-url-native-child-missing", frame); return true;
  }
  const auto navigation = raw->GetController().LoadURLWithParams(content::NavigationController::LoadURLParams(params));
  if (navigation && callback) std::move(callback).Run(*navigation);
  *result = alive.get();
  TraceNativeHost("open-url-accepted", nullptr, static_cast<int>(params.disposition));
  return true;
}

void ZacroInstallExtensionHostNavigation(ZacroExtensionHostOwnerResolver resolver) {
  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
  HostOwnerResolver() = std::move(resolver);
  extensions::ExtensionHost::SetNativeNavigationHooks(
      base::BindRepeating([](extensions::ExtensionHost* host, content::WebContents* source,
          const content::GlobalRenderFrameHostId& opener, const GURL& target, content::WebContents* created) {
        CefBrowserInfoManager::GetInstance()->NativeExtensionHostWebContentsCreated(host, source, opener, target, created);
      }), base::BindRepeating([](extensions::ExtensionHost* host, content::WebContents* source,
          std::unique_ptr<content::WebContents>& created) {
        return CefBrowserInfoManager::GetInstance()->AddNativeExtensionHostContents(host, source, created);
      }), base::BindRepeating([](extensions::ExtensionHost* host, const content::OpenURLParams& params,
          base::OnceCallback<void(content::NavigationHandle&)>& callback, content::WebContents** result) {
        return CefBrowserInfoManager::GetInstance()->OpenNativeExtensionHostURL(host, params, callback, result);
      }));
}

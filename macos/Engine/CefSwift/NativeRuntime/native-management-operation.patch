+namespace extensions {
+namespace {
+NativeManagementOperation* g_current_native_operation = nullptr;
+auto& NativeFunctionOperations() {
+  static base::NoDestructor<std::map<std::string, base::WeakPtr<NativeManagementOperation>>> values;
+  return *values;
+}

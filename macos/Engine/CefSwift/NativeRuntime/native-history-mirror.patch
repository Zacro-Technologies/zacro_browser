+bool HistoryDatabase::InitializeNativeMirrorJournal(bool create, bool allow_reset) {
+  if (!db_.is_open() || native_history_legacy_deletion_failed_) return false;
+  if (!NativeHistoryGeneration(create)) {
+    // A genuine deleteAll retry may have an interrupted reset marker. Only
+    // its pre-deletion scope writer can initialize/validate schema here; normal
+    // observers and readers still reject that marker as unavailable.
+    if (!allow_reset) return false;
+    sql::Statement reset(db_.GetUniqueStatement(
+        "SELECT value FROM meta WHERE key='zacro.native.history.generation.v1'"));
+    if (!reset.Step()) return false;
+    const std::string value = reset.ColumnString(0), prefix = "resetting:";
+    if (!value.starts_with(prefix) || !ParseNativeHistoryGeneration(value.substr(prefix.size())) ||
+        reset.Step() || !reset.Succeeded()) return false;
+  }
+  // This is a new, versioned private schema. An existing object with our name
+  // must match exactly; IF NOT EXISTS alone accepts malformed tables/views.
+  const std::pair<std::string, std::string> schema[] = {
+      {"zacro_native_visit_events",
+       "CREATE TABLE zacro_native_visit_events("
+       "sequence INTEGER PRIMARY KEY AUTOINCREMENT,"
+       "event_id TEXT NOT NULL UNIQUE,document_token TEXT NOT NULL,producer_epoch TEXT NOT NULL,"
+       "logical_id TEXT NOT NULL,generation TEXT NOT NULL,visit_id INTEGER NOT NULL,"
+       "visit_time INTEGER NOT NULL,publish INTEGER NOT NULL,preview INTEGER NOT NULL,library_visit INTEGER NOT NULL)"},
+      {"zacro_native_preview_document",
+       "CREATE INDEX zacro_native_preview_document ON "
+       "zacro_native_visit_events(document_token,publish)"},
+      {"zacro_native_publications",
+       "CREATE TABLE zacro_native_publications(lease_id TEXT PRIMARY KEY,"
+       "document_token TEXT NOT NULL UNIQUE,preview INTEGER NOT NULL,"
+       "captured_event_id TEXT NOT NULL,logical_id TEXT NOT NULL,disposition INTEGER NOT NULL)"},
+      {"zacro_native_retained_visits",
+       "CREATE TABLE zacro_native_retained_visits(generation TEXT NOT NULL,visit_id INTEGER NOT NULL,"
+       "visit_time INTEGER NOT NULL,PRIMARY KEY(generation,visit_id))"},
+      {"zacro_native_legacy_state",
+       "CREATE TABLE zacro_native_legacy_state(singleton INTEGER PRIMARY KEY,initialized INTEGER NOT NULL)"},
+      {"zacro_native_legacy_boundaries",
+       "CREATE TABLE zacro_native_legacy_boundaries(lease_id TEXT PRIMARY KEY,generation TEXT NOT NULL,sequence INTEGER NOT NULL)"},
+      {"zacro_native_legacy_deletions",
+       "CREATE TABLE zacro_native_legacy_deletions(sequence INTEGER PRIMARY KEY AUTOINCREMENT,url_hash TEXT NOT NULL,"
+       "begin_time INTEGER NOT NULL,end_time INTEGER NOT NULL,inclusive_end INTEGER NOT NULL)"},
+      {"zacro_native_legacy_imports",
+       "CREATE TABLE zacro_native_legacy_imports(import_id TEXT PRIMARY KEY,"
+       "generation TEXT NOT NULL,visit_id INTEGER NOT NULL,visit_time INTEGER NOT NULL,"
+       "url_hash TEXT NOT NULL,boundary_id TEXT NOT NULL)"},
+  };
+  for (const auto& [name, expected] : schema) {
+    sql::Statement query(db_.GetUniqueStatement(
+        "SELECT sql FROM sqlite_master WHERE name=?"));
+    query.BindString(0, name);
+    if (query.Step()) {
+      if (query.ColumnString(0) != expected || query.Step() || !query.Succeeded()) return false;
+    } else {
+      if (!query.Succeeded() || !create || !db_.Execute(expected)) return false;
+    }
+  }
+  if (create && !db_.Execute("INSERT OR IGNORE INTO zacro_native_legacy_state(singleton,initialized) VALUES(1,0)")) return false;
+  return true;
+}
+
+bool HistoryDatabase::RecordNativeMirrorVisit(
+    const NativeHistoryDocument& document, VisitID visit_id,
+    base::Time visit_time) {
+  if (!HasActiveTransactions() || visit_id <= 0 || visit_time.is_null() ||
+      !base::Uuid::ParseLowercase(document.document_token).is_valid() ||
+      !base::Uuid::ParseLowercase(document.producer_epoch).is_valid() ||
+      !base::Uuid::ParseLowercase(document.event_id).is_valid() ||
+      document.logical_id.empty() || document.logical_id.size() > 1024 ||
+      document.logical_id.find('\0') != std::string::npos ||
+      !InitializeNativeMirrorJournal()) {
+    return false;
+  }
+  NativeHistoryDocument effective = document;
+  if (!ResolveNativeMirrorPublication(&effective)) return false;
+  // Only the latest unpromoted document visit can become the current Peek.
+  // Removing older preview handoffs does not delete actual Chromium history.
+  if (effective.preview && !effective.publish &&
+      !ForgetNativePreviewDocument(effective.document_token)) return false;
+  // Intermediate SPA identities do not represent Library visits. Keep the
+  // newest one without allowing a page's pushState loop to fill the durable
+  // handoff queue. A captured pending Peek boundary is retained explicitly.
+  sql::Statement superseded(db_.GetUniqueStatement(
+      "DELETE FROM zacro_native_visit_events WHERE document_token=? AND library_visit=0 "
+      "AND NOT EXISTS(SELECT 1 FROM zacro_native_publications p WHERE p.captured_event_id=event_id)"));
+  superseded.BindString(0, effective.document_token);
+  if (!superseded.Run()) return false;
+  sql::Statement count(db_.GetUniqueStatement(
+      "SELECT COUNT(*) FROM zacro_native_visit_events"));
+  if (!count.Step() || count.ColumnInt64(0) >= 20000) return false;
+  const auto generation = NativeHistoryGeneration(false);
+  if (!generation) return false;
+  sql::Statement insert(db_.GetUniqueStatement(
+      "INSERT INTO zacro_native_visit_events(event_id,document_token,logical_id,"
+      "generation,visit_id,visit_time,publish,preview,producer_epoch,library_visit) VALUES(?,?,?,?,?,?,?,?,?,?)"));
+  insert.BindString(0, document.event_id);
+  insert.BindString(1, effective.document_token);
+  insert.BindString(2, effective.logical_id);
+  insert.BindString(3, *generation);
+  insert.BindInt64(4, visit_id);
+  insert.BindInt64(5, visit_time.ToDeltaSinceWindowsEpoch().InMicroseconds());
+  insert.BindBool(6, effective.publish);
+  insert.BindBool(7, effective.preview);
+  insert.BindString(8, document.producer_epoch);
+  insert.BindBool(9, effective.library_visit);
+  return insert.Run();
+}
+
+std::optional<std::vector<HistoryDatabase::NativeMirrorEvent>>
+HistoryDatabase::ReadNativeMirrorEvents(int64_t after_sequence, size_t limit) {
+  if (after_sequence < 0 || limit == 0 || limit > 513 ||
+      !InitializeNativeMirrorJournal()) return std::nullopt;
+  sql::Statement query(db_.GetUniqueStatement(
+      "SELECT e.sequence,e.event_id,e.document_token,e.logical_id,e.visit_id,"
+      "e.visit_time,e.publish,v.visit_time,u.url,v.originator_cache_guid,u.id,e.generation,e.preview,u.title,e.library_visit "
+      "FROM zacro_native_visit_events e LEFT JOIN visits v ON v.id=e.visit_id "
+      "LEFT JOIN urls u ON u.id=v.url WHERE e.sequence>? "
+      "ORDER BY e.sequence LIMIT ?"));
+  query.BindInt64(0, after_sequence);
+  query.BindInt64(1, static_cast<int64_t>(limit));
+  std::vector<NativeMirrorEvent> result;
+  while (query.Step()) {
+    NativeMirrorEvent row;
+    row.sequence = query.ColumnInt64(0);
+    row.event_id = query.ColumnString(1);
+    row.document_token = query.ColumnString(2);
+    row.logical_id = query.ColumnString(3);
+    row.visit_id = query.ColumnInt64(4);
+    row.time_microseconds = query.ColumnInt64(5);
+    row.publish = query.ColumnBool(6);
+    row.preview = query.ColumnBool(12);
+    row.library_visit = query.ColumnBool(14);
+    row.generation = query.ColumnString(11);
+    if (row.sequence <= after_sequence || row.visit_id <= 0 ||
+        row.time_microseconds <= 0 ||
+        !base::Uuid::ParseLowercase(row.event_id).is_valid() ||
+        !base::Uuid::ParseLowercase(row.document_token).is_valid() ||
+        row.logical_id.empty() || row.logical_id.size() > 1024 ||
+        row.logical_id.find('\0') != std::string::npos ||
+        (query.ColumnInt(6) != 0 && query.ColumnInt(6) != 1) ||
+        (query.ColumnInt(12) != 0 && query.ColumnInt(12) != 1) ||
+        (query.ColumnInt(14) != 0 && query.ColumnInt(14) != 1)) return std::nullopt;
+    const auto generation_state = CompareNativeHistoryGeneration(row.generation);
+    if (generation_state == NativeVisitPresence::kError) return std::nullopt;
+    if (generation_state == NativeVisitPresence::kAbsent ||
+        query.GetColumnType(7) == sql::ColumnType::kNull ||
+        query.ColumnInt64(7) != row.time_microseconds) {
+      // deleteAll can reuse numeric VisitIDs. A different native visit time
+      // cannot revive this old event, even if it happens to visit the same URL.
+      row.presence = NativeVisitPresence::kAbsent;
+    } else if (query.GetColumnType(10) == sql::ColumnType::kNull) {
+      return std::nullopt;  // Dangling URL is DB corruption, never absence.
+    } else {
+      row.url = query.ColumnString(8);
+      row.originator = query.ColumnString(9);
+      // Display text is bounded independently of exact identity. Truncating a
+      // title does not weaken URL/VisitID/time verification or erase a visit.
+      row.title = std::string(base::TruncateUTF8ToByteSize(query.ColumnString(13), 8192));
+      const GURL url(row.url);
+      if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() ||
+          url.has_username() || url.has_password() || row.url.size() > 8192 ||
+          !row.originator.empty()) return std::nullopt;
+      row.presence = NativeVisitPresence::kPresent;
+    }
+    result.push_back(std::move(row));
+  }
+  if (!query.Succeeded()) return std::nullopt;
+  return result;
+}
+
+std::optional<HistoryDatabase::NativeMirrorEvent>
+HistoryDatabase::ReadNativeMirrorEvent(const std::string& event_id) {
+  if (!base::Uuid::ParseLowercase(event_id).is_valid() ||
+      !InitializeNativeMirrorJournal()) return std::nullopt;
+  sql::Statement query(db_.GetUniqueStatement(
+      "SELECT sequence FROM zacro_native_visit_events WHERE event_id=?"));
+  query.BindString(0, event_id);
+  if (!query.Step()) return std::nullopt;
+  const int64_t sequence = query.ColumnInt64(0);
+  if (sequence <= 0 || query.Step() || !query.Succeeded()) return std::nullopt;
+  auto rows = ReadNativeMirrorEvents(sequence - 1, 1);
+  if (!rows || rows->size() != 1 || rows->front().event_id != event_id)
+    return std::nullopt;
+  return std::move(rows->front());
+}
+
+bool HistoryDatabase::AcknowledgeNativeMirrorEvents(
+    const std::vector<std::string>& event_ids) {
+  if (event_ids.size() > 512 || !InitializeNativeMirrorJournal()) return false;
+  // Validate every identity before mutating any row. The owning DBTask must
+  // call FlushForNativeMirror and report failure if COMMIT fails.
+  for (const auto& id : event_ids)
+    if (!base::Uuid::ParseLowercase(id).is_valid()) return false;
+  // Core has committed these visits. Protect that exact tuple before dropping
+  // its journal from automatic age expiry; explicit user/API deletion bypasses retention.
+  for (const auto& id : event_ids) {
+    sql::Statement query(db_.GetUniqueStatement(
+        "SELECT generation,visit_id,visit_time,publish,library_visit FROM zacro_native_visit_events WHERE event_id=?"));
+    query.BindString(0, id);
+    if (query.Step()) {
+      if (query.ColumnBool(3) && query.ColumnBool(4) && !RetainNativeMirrorVisit({query.ColumnString(0), query.ColumnInt64(1), query.ColumnInt64(2)})) return false;
+      if (query.Step() || !query.Succeeded()) return false;
+    } else if (!query.Succeeded()) return false;
+  }
+  sql::Statement remove(db_.GetUniqueStatement(
+      "DELETE FROM zacro_native_visit_events WHERE event_id=?"));
+  for (const auto& id : event_ids) {
+    remove.Reset(true);
+    remove.BindString(0, id);
+    if (!remove.Run()) return false;
+  }
+  return true;
+}
+
+bool HistoryDatabase::ForgetNativePreviewDocument(
+    const std::string& document_token) {
+  if (!base::Uuid::ParseLowercase(document_token).is_valid()) return false;
+  sql::Statement remove(db_.GetUniqueStatement(
+      "DELETE FROM zacro_native_visit_events WHERE document_token=? AND publish=0 AND preview=1"));
+  remove.BindString(0, document_token);
+  return remove.Run();
+}
+
+bool HistoryDatabase::PruneNativeMirrorOrphans(const std::string& producer_epoch,
+    const std::set<std::string>& closed_documents) {
+  if (!HasActiveTransactions() || closed_documents.size() > 20000 ||
+      !base::Uuid::ParseLowercase(producer_epoch).is_valid() ||
+      !InitializeNativeMirrorJournal()) return false;
+  for (const auto& token : closed_documents)
+    if (!base::Uuid::ParseLowercase(token).is_valid()) return false;
+  // Never prune a document merely absent from an earlier live-token snapshot:
+  // a newly created producer can commit while this DB task is queued. Only a
+  // prior process epoch or an exact native destruction notification is proof.
+  // Publication leases survive producer closure until durable Core replay.
+  sql::Statement query(db_.GetUniqueStatement(
+      "SELECT DISTINCT e.document_token,e.producer_epoch FROM zacro_native_visit_events e "
+      "WHERE e.publish=0 AND NOT EXISTS(SELECT 1 FROM zacro_native_publications p "
+      "WHERE p.document_token=e.document_token) LIMIT 20001"));
+  std::vector<std::string> orphans;
+  size_t examined = 0;
+  while (query.Step()) {
+    const auto token = query.ColumnString(0), epoch = query.ColumnString(1);
+    if (!base::Uuid::ParseLowercase(token).is_valid() ||
+        !base::Uuid::ParseLowercase(epoch).is_valid() || ++examined > 20000) return false;
+    if (epoch != producer_epoch || closed_documents.contains(token)) orphans.push_back(token);
+  }
+  if (!query.Succeeded()) return false;
+  sql::Statement remove(db_.GetUniqueStatement(
+      "DELETE FROM zacro_native_visit_events WHERE document_token=? AND publish=0 "
+      "AND NOT EXISTS(SELECT 1 FROM zacro_native_publications p WHERE p.document_token=?)"));
+  for (const auto& token : orphans) {
+    remove.Reset(true); remove.BindString(0, token); remove.BindString(1, token);
+    if (!remove.Run()) return false;
+  }
+  return true;
+}
+
+namespace {
+bool ValidNativePublication(const HistoryDatabase::NativeMirrorPublication& value) {
+  return base::Uuid::ParseLowercase(value.lease_id).is_valid() &&
+      base::Uuid::ParseLowercase(value.document_token).is_valid() &&
+      (value.captured_event_id.empty() || (value.preview &&
+       base::Uuid::ParseLowercase(value.captured_event_id).is_valid()));
+}
+bool SameNativePublication(const HistoryDatabase::NativeMirrorPublication& a,
+                           const HistoryDatabase::NativeMirrorPublication& b) {
+  return a.lease_id == b.lease_id && a.document_token == b.document_token &&
+      a.preview == b.preview && a.captured_event_id == b.captured_event_id;
+}
+bool ValidNativeLogicalID(const std::string& id) {
+  return !id.empty() && id.size() <= 1024 && id.find('\0') == std::string::npos;
+}
+}  // namespace
+
+std::optional<std::vector<HistoryDatabase::NativeMirrorPublication>>
+HistoryDatabase::ReadNativeMirrorPublications() {
+  if (!InitializeNativeMirrorJournal()) return std::nullopt;
+  sql::Statement query(db_.GetUniqueStatement(
+      "SELECT lease_id,document_token,preview,captured_event_id,logical_id,disposition "
+      "FROM zacro_native_publications ORDER BY lease_id LIMIT 1001"));
+  std::vector<NativeMirrorPublication> result;
+  while (query.Step()) {
+    NativeMirrorPublication value;
+    value.lease_id = query.ColumnString(0);
+    value.document_token = query.ColumnString(1);
+    value.preview = query.ColumnBool(2);
+    value.captured_event_id = query.ColumnString(3);
+    value.logical_id = query.ColumnString(4);
+    const int disposition = query.ColumnInt(5);
+    if (!ValidNativePublication(value) || result.size() >= 1000 ||
+        (query.ColumnInt(2) != 0 && query.ColumnInt(2) != 1) ||
+        disposition < 0 || disposition > 2 ||
+        (disposition == 1 ? !ValidNativeLogicalID(value.logical_id)
+                          : !value.logical_id.empty())) return std::nullopt;
+    value.disposition = static_cast<NativeMirrorPublication::Disposition>(disposition);
+    result.push_back(std::move(value));
+  }
+  if (!query.Succeeded()) return std::nullopt;
+  return result;
+}
+
+bool HistoryDatabase::PrepareNativeMirrorPublication(
+    const NativeMirrorPublication& lease) {
+  using Disposition = NativeMirrorPublication::Disposition;
+  if (!HasActiveTransactions() || !ValidNativePublication(lease) ||
+      lease.disposition != Disposition::kPrepared || !lease.logical_id.empty()) return false;
+  const auto leases = ReadNativeMirrorPublications();
+  if (!leases) return false;
+  for (const auto& existing : *leases) {
+    if (existing.lease_id == lease.lease_id || existing.document_token == lease.document_token)
+      return SameNativePublication(existing, lease) && existing.disposition == Disposition::kPrepared;
+  }
+  if (leases->size() >= 1000) return false;
+  if (!lease.captured_event_id.empty()) {
+    sql::Statement captured(db_.GetUniqueStatement(
+        "SELECT document_token,publish FROM zacro_native_visit_events WHERE event_id=?"));
+    captured.BindString(0, lease.captured_event_id);
+    if (!captured.Step() || captured.ColumnString(0) != lease.document_token ||
+        captured.ColumnInt(1) != 0 || captured.Step() || !captured.Succeeded()) return false;
+  }
+  sql::Statement insert(db_.GetUniqueStatement(
+      "INSERT INTO zacro_native_publications(lease_id,document_token,preview,"
+      "captured_event_id,logical_id,disposition) VALUES(?,?,?,?,'',0)"));
+  insert.BindString(0, lease.lease_id);
+  insert.BindString(1, lease.document_token);
+  insert.BindBool(2, lease.preview);
+  insert.BindString(3, lease.captured_event_id);
+  if (!insert.Run()) return false;
+  if (lease.preview) {
+    // Pending producer handoffs carry preview=false. Keep the exact captured
+    // event and those later handoffs, never an earlier unpromoted document.
+    sql::Statement prune(db_.GetUniqueStatement(
+        "DELETE FROM zacro_native_visit_events WHERE document_token=? AND "
+        "publish=0 AND preview=1 AND event_id<>?"));
+    prune.BindString(0, lease.document_token);
+    prune.BindString(1, lease.captured_event_id);
+    if (!prune.Run()) return false;
+  }
+  return true;
+}
+
+bool HistoryDatabase::ResolveNativeMirrorPublication(NativeHistoryDocument* document) {
+  sql::Statement query(db_.GetUniqueStatement(
+      "SELECT preview,logical_id,disposition FROM zacro_native_publications WHERE document_token=?"));
+  query.BindString(0, document->document_token);
+  if (!query.Step()) return query.Succeeded();  // No lease is an ordinary visit.
+  const int preview = query.ColumnInt(0), disposition = query.ColumnInt(2);
+  const std::string logical_id = query.ColumnString(1);
+  if ((preview != 0 && preview != 1) || disposition < 0 || disposition > 2 ||
+      (disposition == 1 ? !ValidNativeLogicalID(logical_id) : !logical_id.empty()) ||
+      query.Step() || !query.Succeeded()) return false;
+  if (disposition == 1) {
+    document->logical_id = logical_id;
+    document->publish = true;
+    document->preview = false;
+  } else {
+    document->publish = false;
+    // Prepared preserves every handoff; cancelled restores original Peek vs
+    // provisional-popup semantics even for old flags still queued on the DB.
+    document->preview = disposition == 2 && preview == 1;
+  }
+  return true;
+}
+
+bool HistoryDatabase::CommitNativeMirrorPublication(
+    const NativeMirrorPublication& lease, const std::string& logical_id) {
+  using Disposition = NativeMirrorPublication::Disposition;
+  if (!HasActiveTransactions() || !ValidNativePublication(lease) ||
+      !ValidNativeLogicalID(logical_id)) return false;
+  const auto leases = ReadNativeMirrorPublications();
+  if (!leases) return false;
+  const NativeMirrorPublication* found = nullptr;
+  for (const auto& value : *leases) if (value.lease_id == lease.lease_id) found = &value;
+  if (!found || !SameNativePublication(*found, lease) ||
+      found->disposition == Disposition::kCancelled ||
+      (found->disposition == Disposition::kCommitted && found->logical_id != logical_id)) return false;
+  sql::Statement update(db_.GetUniqueStatement(
+      "UPDATE zacro_native_publications SET logical_id=?,disposition=1 WHERE lease_id=?"));
+  update.BindString(0, logical_id); update.BindString(1, lease.lease_id);
+  if (!update.Run()) return false;
+  sql::Statement publish(db_.GetUniqueStatement(
+      "UPDATE zacro_native_visit_events SET logical_id=?,publish=1,preview=0,"
+      "library_visit=CASE WHEN event_id=? THEN 1 ELSE library_visit END "
+      "WHERE document_token=? AND publish=0"));
+  publish.BindString(0, logical_id); publish.BindString(1, lease.captured_event_id);
+  publish.BindString(2, lease.document_token);
+  return publish.Run();
+}
+
+bool HistoryDatabase::CancelNativeMirrorPublication(const NativeMirrorPublication& lease) {
+  using Disposition = NativeMirrorPublication::Disposition;
+  if (!HasActiveTransactions() || !ValidNativePublication(lease)) return false;
+  const auto leases = ReadNativeMirrorPublications();
+  if (!leases) return false;
+  const NativeMirrorPublication* found = nullptr;
+  for (const auto& value : *leases) if (value.lease_id == lease.lease_id) found = &value;
+  if (!found || !SameNativePublication(*found, lease) ||
+      found->disposition == Disposition::kCommitted) return false;
+  sql::Statement update(db_.GetUniqueStatement(
+      "UPDATE zacro_native_publications SET disposition=2 WHERE lease_id=?"));
+  update.BindString(0, lease.lease_id);
+  if (!update.Run()) return false;
+  if (lease.preview) {
+    sql::Statement prune(db_.GetUniqueStatement(
+        "DELETE FROM zacro_native_visit_events WHERE document_token=? AND publish=0 AND sequence<>"
+        "(SELECT MAX(sequence) FROM zacro_native_visit_events WHERE document_token=? AND publish=0)"));
+    prune.BindString(0, lease.document_token); prune.BindString(1, lease.document_token);
+    if (!prune.Run()) return false;
+    sql::Statement latest(db_.GetUniqueStatement(
+        "UPDATE zacro_native_visit_events SET preview=1 WHERE document_token=? AND publish=0"));
+    latest.BindString(0, lease.document_token);
+    if (!latest.Run()) return false;
+  }
+  return true;
+}
+
+bool HistoryDatabase::FinalizeNativeMirrorPublication(
+    const NativeMirrorPublication& lease, const std::string& logical_id) {
+  using Disposition = NativeMirrorPublication::Disposition;
+  if (!HasActiveTransactions() || !ValidNativePublication(lease)) return false;
+  const auto leases = ReadNativeMirrorPublications();
+  if (!leases) return false;
+  for (const auto& value : *leases) if (value.lease_id == lease.lease_id) {
+    if (!SameNativePublication(value, lease) || value.logical_id != logical_id ||
+        value.disposition == Disposition::kPrepared) return false;
+    sql::Statement remove(db_.GetUniqueStatement(
+        "DELETE FROM zacro_native_publications WHERE lease_id=?"));
+    remove.BindString(0, lease.lease_id);
+    return remove.Run();
+  }
+  // Finalization cannot authorize publication, so a repeated delete is safe.
+  return true;
+}
+
+namespace {
+bool ValidNativeLegacyHash(const std::string& value) {
+  return value.size() == 64 && std::ranges::all_of(value, [](char c) {
+    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+  });
+}
+}  // namespace
+
+bool HistoryDatabase::FindNativeLegacyImport(const NativeHistoryLegacyInput& input,
+    std::optional<NativeHistoryLegacyResult>* result) {
+  if (!result || !ValidNativeLegacyHash(input.import_id) ||
+      !ValidNativeLegacyHash(input.requested_url_hash) ||
+      !input.url.SchemeIsHTTPOrHTTPS() || input.url.has_username() || input.url.has_password() ||
+      input.url.spec().size() > 8192 || input.time.is_null() || !InitializeNativeMirrorJournal()) return false;
+  result->reset();
+  sql::Statement query(db_.GetUniqueStatement(
+      "SELECT generation,visit_id,visit_time,url_hash,boundary_id FROM zacro_native_legacy_imports WHERE import_id=?"));
+  query.BindString(0, input.import_id);
+  if (!query.Step()) return query.Succeeded();
+  NativeHistoryLegacyResult value;
+  value.import_id = input.import_id; value.generation = query.ColumnString(0);
+  value.boundary_id = query.ColumnString(4);
+  value.visit_id = query.ColumnInt64(1); value.time_microseconds = query.ColumnInt64(2);
+  if (query.ColumnString(3) != input.requested_url_hash || value.boundary_id != input.boundary_id || value.visit_id < 0 ||
+      value.time_microseconds != input.time.ToDeltaSinceWindowsEpoch().InMicroseconds() ||
+      query.Step() || !query.Succeeded()) return false;
+  if (!value.visit_id) { *result = std::move(value); return true; }
+  const auto presence = CheckNativeHistoryVisit(value.generation, value.visit_id,
+      value.time_microseconds, input.url.spec(), "");
+  if (presence == NativeVisitPresence::kError) return false;
+  value.present = presence == NativeVisitPresence::kPresent;
+  if (value.present) value.url = input.url.spec();
+  *result = std::move(value); return true;
+}
+
+bool HistoryDatabase::RecordNativeLegacyImport(const NativeHistoryLegacyInput& input, VisitID visit) {
+  if (!HasActiveTransactions() || !ValidNativeLegacyHash(input.import_id) ||
+      !ValidNativeLegacyHash(input.requested_url_hash) || visit < 0 ||
+      !base::Uuid::ParseLowercase(input.boundary_id).is_valid() ||
+      input.time.ToDeltaSinceWindowsEpoch().InMicroseconds() <= 0 || !InitializeNativeMirrorJournal()) return false;
+  const auto generation = NativeHistoryGeneration(false);
+  bool allowed = false;
+  if (!generation || !NativeLegacyInputAllowed(input, &allowed) ||
+      (visit ? (!allowed || CheckNativeHistoryVisit(*generation, visit,
+      input.time.ToDeltaSinceWindowsEpoch().InMicroseconds(), input.url.spec(), "") != NativeVisitPresence::kPresent) : allowed)) return false;
+  sql::Statement count(db_.GetUniqueStatement("SELECT COUNT(*) FROM zacro_native_legacy_imports"));
+  if (!count.Step() || count.ColumnInt64(0) >= 20000) return false;
+  sql::Statement insert(db_.GetUniqueStatement(
+      "INSERT INTO zacro_native_legacy_imports(import_id,generation,visit_id,visit_time,url_hash,boundary_id) VALUES(?,?,?,?,?,?)"));
+  insert.BindString(0, input.import_id); insert.BindString(1, *generation); insert.BindInt64(2, visit);
+  insert.BindInt64(3, input.time.ToDeltaSinceWindowsEpoch().InMicroseconds()); insert.BindString(4, input.requested_url_hash);
+  insert.BindString(5, input.boundary_id);
+  return insert.Run();
+}
+
+bool HistoryDatabase::AcknowledgeNativeLegacyImports(
+    const std::vector<std::pair<std::string, std::string>>& identities) {
+  if (!HasActiveTransactions() || identities.size() > 512 || !InitializeNativeMirrorJournal()) return false;
+  // Validate every generation before deleting any prefix. An old Core ack may
+  // never erase a same-ID import in an unrelated/recreated database.
+  for (const auto& [id, generation] : identities) {
+    if (!ValidNativeLegacyHash(id) || !ParseNativeHistoryGeneration(generation)) return false;
+    sql::Statement query(db_.GetUniqueStatement(
+        "SELECT generation,visit_id,visit_time FROM zacro_native_legacy_imports WHERE import_id=?"));
+    query.BindString(0, id);
+    if (query.Step()) {
+      if (query.ColumnString(0) != generation ||
+          (query.ColumnInt64(1) > 0 && !RetainNativeMirrorVisit({generation, query.ColumnInt64(1), query.ColumnInt64(2)})) ||
+          query.Step() || !query.Succeeded()) return false;
+    } else if (!query.Succeeded()) return false;
+  }
+  sql::Statement remove(db_.GetUniqueStatement(
+      "DELETE FROM zacro_native_legacy_imports WHERE import_id=? AND generation=?"));
+  for (const auto& [id, generation] : identities) {
+    remove.Reset(true); remove.BindString(0, id); remove.BindString(1, generation);
+    if (!remove.Run()) return false;
+  }
+  return true;
+}
+
+bool HistoryDatabase::RetainNativeMirrorVisit(const NativeHistoryRetention& identity) {
+  if (!HasActiveTransactions() || identity.visit_id <= 0 || identity.time_microseconds <= 0 ||
+      !InitializeNativeMirrorJournal()) return false;
+  const auto generation = CompareNativeHistoryGeneration(identity.generation);
+  if (generation == NativeVisitPresence::kError) return false;
+  if (generation == NativeVisitPresence::kAbsent) return true;
+  sql::Statement visit(db_.GetUniqueStatement("SELECT visit_time FROM visits WHERE id=?"));
+  visit.BindInt64(0, identity.visit_id);
+  if (!visit.Step()) return visit.Succeeded();
+  if (visit.ColumnInt64(0) != identity.time_microseconds) return true;
+  if (visit.Step() || !visit.Succeeded()) return false;
+  sql::Statement count(db_.GetUniqueStatement("SELECT COUNT(*) FROM zacro_native_retained_visits"));
+  if (!count.Step()) return false;
+  if (count.ColumnInt64(0) >= 40000) {
+    sql::Statement same(db_.GetUniqueStatement(
+        "SELECT 1 FROM zacro_native_retained_visits WHERE generation=? AND visit_id=? AND visit_time=?"));
+    same.BindString(0, identity.generation); same.BindInt64(1, identity.visit_id); same.BindInt64(2, identity.time_microseconds);
+    if (!same.Step()) return false;
+  }
+  sql::Statement insert(db_.GetUniqueStatement(
+      "INSERT OR REPLACE INTO zacro_native_retained_visits(generation,visit_id,visit_time) VALUES(?,?,?)"));
+  insert.BindString(0, identity.generation); insert.BindInt64(1, identity.visit_id); insert.BindInt64(2, identity.time_microseconds);
+  return insert.Run();
+}
+
+bool HistoryDatabase::ReplaceNativeMirrorRetention(const std::vector<NativeHistoryRetention>& identities) {
+  if (!HasActiveTransactions() || identities.size() > 20000 || !InitializeNativeMirrorJournal()) return false;
+  for (const auto& identity : identities) {
+    if (identity.visit_id <= 0 || identity.time_microseconds <= 0 ||
+        CompareNativeHistoryGeneration(identity.generation) == NativeVisitPresence::kError) return false;
+  }
+  // The owning backend supplies a dedicated atomic transaction. Failed
+  // replacement rolls back to the old retention authority, never an empty set.
+  if (!db_.Execute("DELETE FROM zacro_native_retained_visits")) return false;
+  for (const auto& identity : identities) if (!RetainNativeMirrorVisit(identity)) return false;
+  return true;
+}
+
+bool HistoryDatabase::ReadNativeExpiringVisits(base::Time begin_time, base::Time end_time,
+    int max_visits, std::optional<ui::PageTransition> transition, VisitVector* visits) {
+  if (!visits || max_visits <= 0) return false;
+  visits->clear();
+  if (!transition && native_history_automatic_expiration_reads_ < std::numeric_limits<int64_t>::max())
+    ++native_history_automatic_expiration_reads_;
+  sql::Statement native(db_.GetUniqueStatement(
+      "SELECT value FROM meta WHERE key='zacro.native.history.generation.v1'"));
+  if (!native.Step()) {
+    if (!native.Succeeded()) return false;
+    return transition ? GetVisitsInRangeForTransition(begin_time, end_time, max_visits, *transition, visits)
+        : GetAllVisitsInRange(begin_time, end_time, kNoAppIdFilter, max_visits, visits);
+  }
+  const std::string generation = native.ColumnString(0);
+  if (!ParseNativeHistoryGeneration(generation) || native.Step() || !native.Succeeded() ||
+      !InitializeNativeMirrorJournal(/*create=*/false)) return false;
+  std::string query = "SELECT" HISTORY_VISIT_ROW_FIELDS "FROM visits WHERE visit_time>=? AND visit_time<? ";
+  if (transition) query += "AND (transition & ?) == ? ";
+  query += "AND NOT EXISTS(SELECT 1 FROM zacro_native_retained_visits r WHERE r.visit_id=visits.id "
+      "AND r.visit_time=visits.visit_time AND r.generation=?) "
+      "AND NOT EXISTS(SELECT 1 FROM zacro_native_visit_events e WHERE e.visit_id=visits.id "
+      "AND e.visit_time=visits.visit_time AND e.generation=? AND e.publish=1 AND e.library_visit=1) "
+      "AND NOT EXISTS(SELECT 1 FROM zacro_native_legacy_imports i WHERE i.visit_id=visits.id "
+      "AND i.visit_time=visits.visit_time AND i.generation=?) ORDER BY visit_time LIMIT ?";
+  sql::Statement rows(db_.GetUniqueStatement(query));
+  rows.BindTime(0, begin_time); rows.BindTime(1, end_time);
+  int parameter = 2;
+  if (transition) {
+    rows.BindInt64(parameter++, ui::PAGE_TRANSITION_CORE_MASK); rows.BindInt64(parameter++, *transition);
+  }
+  rows.BindString(parameter++, generation); rows.BindString(parameter++, generation); rows.BindString(parameter++, generation);
+  rows.BindInt(parameter, max_visits);
+  return FillVisitVector(rows, visits);
+}
+
+std::optional<std::pair<int64_t, int>> HistoryDatabase::NativeHistoryRetentionStatus() {
+  if (!InitializeNativeMirrorJournal()) return std::nullopt;
+  sql::Statement count(db_.GetUniqueStatement("SELECT COUNT(*) FROM zacro_native_retained_visits"));
+  if (!count.Step()) return std::nullopt;
+  const int64_t retained = count.ColumnInt64(0);
+  if (retained < 0 || retained > 40000 || count.Step() || !count.Succeeded()) return std::nullopt;
+  return std::make_pair(native_history_automatic_expiration_reads_, static_cast<int>(retained));
+}
+
+std::optional<std::vector<std::string>> HistoryDatabase::ReadNativeLegacyBoundaries() {
+  if (!InitializeNativeMirrorJournal()) return std::nullopt;
+  sql::Statement rows(db_.GetUniqueStatement("SELECT lease_id FROM zacro_native_legacy_boundaries ORDER BY lease_id LIMIT 1001"));
+  std::vector<std::string> values;
+  while (rows.Step()) {
+    const auto id = rows.ColumnString(0);
+    if (!base::Uuid::ParseLowercase(id).is_valid() || values.size() >= 1000) return std::nullopt;
+    values.push_back(id);
+  }
+  if (!rows.Succeeded()) return std::nullopt;
+  return values;
+}
+
+std::optional<std::string> HistoryDatabase::CreateNativeLegacyBoundary() {
+  if (!HasActiveTransactions() || !InitializeNativeMirrorJournal()) return std::nullopt;
+  const auto existing = ReadNativeLegacyBoundaries();
+  const auto generation = NativeHistoryGeneration(false);
+  if (!existing || !generation || existing->size() >= 1000) return std::nullopt;
+  sql::Statement state(db_.GetUniqueStatement("SELECT initialized FROM zacro_native_legacy_state WHERE singleton=1"));
+  if (!state.Step() || (state.ColumnInt(0) != 0 && state.ColumnInt(0) != 1)) return std::nullopt;
+  const bool initialized = state.ColumnBool(0);
+  if (state.Step() || !state.Succeeded()) return std::nullopt;
+  int64_t boundary = 0;
+  if (initialized) {
+    sql::Statement sequence(db_.GetUniqueStatement("SELECT COALESCE(MAX(sequence),0) FROM zacro_native_legacy_deletions"));
+    if (!sequence.Step()) return std::nullopt;
+    boundary = sequence.ColumnInt64(0);
+    if (boundary < 0 || sequence.Step() || !sequence.Succeeded()) return std::nullopt;
+  }
+  const auto lease = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  sql::Statement insert(db_.GetUniqueStatement("INSERT INTO zacro_native_legacy_boundaries(lease_id,generation,sequence) VALUES(?,?,?)"));
+  insert.BindString(0, lease); insert.BindString(1, *generation); insert.BindInt64(2, boundary);
+  if (!insert.Run()) return std::nullopt;
+  return lease;
+}
+
+bool HistoryDatabase::FinalizeNativeLegacyBoundary(const std::string& lease, bool completed_initial) {
+  if (!HasActiveTransactions() || !base::Uuid::ParseLowercase(lease).is_valid() || !InitializeNativeMirrorJournal()) return false;
+  sql::Statement exists(db_.GetUniqueStatement("SELECT 1 FROM zacro_native_legacy_boundaries WHERE lease_id=?"));
+  exists.BindString(0, lease);
+  const bool found = exists.Step();
+  if ((found && (exists.Step() || !exists.Succeeded())) || (!found && !exists.Succeeded())) return false;
+  if (!found && completed_initial) {
+    sql::Statement state(db_.GetUniqueStatement("SELECT initialized FROM zacro_native_legacy_state WHERE singleton=1"));
+    if (!state.Step() || state.ColumnInt(0) != 1 || state.Step() || !state.Succeeded()) return false;
+    return true;  // Idempotent completed receipt, never new initial authority.
+  }
+  sql::Statement pending(db_.GetUniqueStatement("SELECT 1 FROM zacro_native_legacy_imports WHERE boundary_id=? LIMIT 1"));
+  pending.BindString(0, lease);
+  if (pending.Step() || !pending.Succeeded()) return false;
+  sql::Statement remove(db_.GetUniqueStatement("DELETE FROM zacro_native_legacy_boundaries WHERE lease_id=?"));
+  remove.BindString(0, lease); if (!remove.Run()) return false;
+  if (completed_initial && !db_.Execute("UPDATE zacro_native_legacy_state SET initialized=1 WHERE singleton=1")) return false;
+  // No new lease may need scopes before the minimum surviving boundary. Keep
+  // initial scopes until Core explicitly confirms its complete initial snapshot.
+  return db_.Execute("DELETE FROM zacro_native_legacy_deletions WHERE "
+      "(SELECT initialized FROM zacro_native_legacy_state WHERE singleton=1)=1 AND sequence<="
+      "COALESCE((SELECT MIN(sequence) FROM zacro_native_legacy_boundaries),9223372036854775807)");
+}
+
+bool HistoryDatabase::NativeLegacyInputAllowed(const NativeHistoryLegacyInput& input, bool* allowed) {
+  if (!allowed || !base::Uuid::ParseLowercase(input.boundary_id).is_valid() || !InitializeNativeMirrorJournal()) return false;
+  *allowed = false;
+  sql::Statement lease(db_.GetUniqueStatement("SELECT generation,sequence FROM zacro_native_legacy_boundaries WHERE lease_id=?"));
+  lease.BindString(0, input.boundary_id);
+  if (!lease.Step()) return false;  // Missing proof is unavailable, never a fresh boundary.
+  const auto generation = CompareNativeHistoryGeneration(lease.ColumnString(0));
+  const int64_t sequence = lease.ColumnInt64(1);
+  if (generation == NativeVisitPresence::kError || sequence < 0 || lease.Step() || !lease.Succeeded()) return false;
+  if (generation == NativeVisitPresence::kAbsent) return true;
+  sql::Statement scopes(db_.GetUniqueStatement(
+      "SELECT 1 FROM zacro_native_legacy_deletions WHERE sequence>? AND (url_hash='' OR url_hash=?) "
+      "AND begin_time<=? AND (end_time>? OR (inclusive_end=1 AND end_time=?)) LIMIT 1"));
+  const auto canonical_hash = base::HexEncodeLower(crypto::hash::Sha256(input.url.spec()));
+  const int64_t time = input.time.ToDeltaSinceWindowsEpoch().InMicroseconds();
+  scopes.BindInt64(0, sequence); scopes.BindString(1, canonical_hash);
+  scopes.BindInt64(2, time); scopes.BindInt64(3, time); scopes.BindInt64(4, time);
+  if (scopes.Step()) return true;
+  if (!scopes.Succeeded()) return false;
+  *allowed = true; return true;
+}
+
+bool HistoryDatabase::RecordNativeLegacyDeletion(const std::optional<GURL>& url,
+    base::Time begin, base::Time end, bool inclusive_end, bool allow_reset) {
+  if (!InitializeNativeMirrorJournal(/*create=*/true, allow_reset)) return false;
+  sql::Statement needed(db_.GetUniqueStatement("SELECT initialized=0 OR EXISTS(SELECT 1 FROM zacro_native_legacy_boundaries) "
+      "FROM zacro_native_legacy_state WHERE singleton=1"));
+  if (!needed.Step()) return false;
+  const bool capture = needed.ColumnBool(0);
+  if (needed.Step() || !needed.Succeeded()) return false;
+  if (!capture) return true;
+  sql::Statement count(db_.GetUniqueStatement("SELECT COUNT(*) FROM zacro_native_legacy_deletions"));
+  if (!count.Step() || count.ColumnInt64(0) >= 20000) return false;
+  const int64_t first = begin.is_null() ? 0 : begin.ToDeltaSinceWindowsEpoch().InMicroseconds();
+  const int64_t last = end.is_null() || end.is_max() ? std::numeric_limits<int64_t>::max()
+      : end.ToDeltaSinceWindowsEpoch().InMicroseconds();
+  sql::Statement insert(db_.GetUniqueStatement("INSERT INTO zacro_native_legacy_deletions(url_hash,begin_time,end_time,inclusive_end) VALUES(?,?,?,?)"));
+  insert.BindString(0, url ? base::HexEncodeLower(crypto::hash::Sha256(url->spec())) : "");
+  insert.BindInt64(1, first); insert.BindInt64(2, last); insert.BindBool(3, inclusive_end);
+  return insert.Run();
+}
+
+bool HistoryDatabase::RecordNativeLegacyDeletions(
+    const std::vector<NativeHistoryDeletionScope>& scopes, bool allow_reset) {
+  const auto fail_closed = [&]() {
+    native_history_legacy_deletion_failed_ = true;
+    // No caller may mutate actual visits after this failure. Checked native
+    // observation/import also stays unavailable for this database lifetime.
+    // Revoke old migration evidence durably when SQLite can still write, so a
+    // restart cannot retry the incomplete batch under its previous lease.
+    if (!db_.Execute("DELETE FROM zacro_native_legacy_boundaries"))
+      DLOG(ERROR) << "Could not revoke failed native history migration boundaries";
+    return false;
+  };
+  if (native_history_legacy_deletion_failed_) return false;
+  if (scopes.size() > 20000 || !InitializeNativeMirrorJournal(/*create=*/true, allow_reset)) return fail_closed();
+  // sql::Transaction nesting is virtual and could roll back unrelated real
+  // browsing. This local SQLite savepoint owns ONLY the preflight scope rows.
+  // A failed later scope cannot leave a false successful prefix behind.
+  if (!db_.Execute("SAVEPOINT zacro_native_legacy_deletion_scope")) return fail_closed();
+  bool recorded = true;
+  for (const auto& scope : scopes) {
+    if (!RecordNativeLegacyDeletion(scope.url, scope.begin, scope.end, scope.inclusive_end, allow_reset)) {
+      recorded = false; break;
+    }
+  }
+  if (recorded && db_.Execute("RELEASE zacro_native_legacy_deletion_scope")) return true;
+  const bool rolled_back = db_.Execute("ROLLBACK TO zacro_native_legacy_deletion_scope");
+  const bool released = db_.Execute("RELEASE zacro_native_legacy_deletion_scope");
+  if (!rolled_back || !released) DLOG(ERROR) << "Could not roll back failed native history deletion scope";
+  return fail_closed();
 }
 

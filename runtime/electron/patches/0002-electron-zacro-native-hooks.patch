@@ -0,0 +1,257 @@
+// These acceptance tests require the patched binary. Stock Electron must fail.
+import { BrowserWindow, session, type Session } from 'electron/main';
+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it } from 'vitest';
+import { spawn } from 'node:child_process';
+import { once } from 'node:events';
+import * as fs from 'node:fs/promises';
+import * as http from 'node:http';
+import * as os from 'node:os';
+import * as path from 'node:path';
+import { closeAllWindows } from './lib/window-helpers.ts';
+
+interface NativeHooks {
+  getZacroCapabilities(): Record<string, number | boolean>;
+  grantZacroActiveTab(id: string, tab: number): Promise<void>;
+  setZacroReviewedPermissions(id: string, value: { permissions: string[]; origins: string[] }): Promise<void>;
+  setZacroUserScriptsEnabled(id: string, enabled: boolean): void;
+  setZacroFontPreferences(value: Record<string, unknown>): void;
+  getZacroFontPreferences(): { fonts: Array<{script: string; genericFamily: string; fontId: string}>; defaultFontSize: number; defaultFixedFontSize: number; minimumFontSize: number };
+  getZacroFontList(): Promise<Array<{ fontId: string; displayName: string }>>;
+}
+const native = (s: Session) => s.extensions as unknown as NativeHooks;
+
+describe('Zacro privileged native capabilities v1', () => {
+  let directory: string;
+  let profile: Session;
+  let server: http.Server;
+  let url: string;
+  let sequence = 0;
+  const loaded: Array<{ profile: Session; id: string }> = [];
+
+  beforeAll(async () => {
+    directory = await fs.mkdtemp(path.join(os.tmpdir(), 'zacro-native-'));
+    server = http.createServer((_req, res) => {
+      res.setHeader('Content-Type', 'text/html');
+      res.end('<html><body><span id="generic" style="font-family:serif">WWWWiiii</span><span id="explicit" style="font:31px monospace">WWWWiiii</span></body></html>');
+    });
+    server.listen(0, '127.0.0.1');
+    await once(server, 'listening');
+    url = `http://127.0.0.1:${(server.address() as { port: number }).port}/`;
+  });
+  beforeEach(() => {
+    profile = session.fromPartition(`persist:zacro-native-${Date.now()}-${sequence++}`);
+    expect(native(profile).getZacroCapabilities()).toEqual({
+      version: 1, activeTab: true, reviewedPermissions: true, userScripts: true, fontSettings: true
+    });
+  });
+  afterEach(async () => {
+    await closeAllWindows();
+    for (const item of loaded.splice(0)) item.profile.extensions.removeExtension(item.id);
+  });
+  afterAll(async () => {
+    server.close();
+    await fs.rm(directory, { recursive: true, force: true });
+  });
+
+  async function extension(permissions = ['activeTab', 'scripting'], origins: string[] = []) {
+    const extensionPath = path.join(directory, `extension-${sequence++}`);
+    await fs.mkdir(extensionPath);
+    await fs.writeFile(path.join(extensionPath, 'manifest.json'), JSON.stringify({
+      manifest_version: 3, name: 'Native capability acceptance', version: '1.0',
+      permissions, host_permissions: origins, optional_permissions: ['storage'],
+      optional_host_permissions: ['http://*/*']
+    }));
+    await fs.writeFile(path.join(extensionPath, 'page.html'), '<!doctype html><body>Native caller</body>');
+    const ext = await profile.extensions.loadExtension(extensionPath, {
+      allowFileAccess: false,
+      zacroReviewedPermissions: { permissions, origins }
+    } as Electron.LoadExtensionOptions);
+    loaded.push({ profile, id: ext.id });
+    const caller = new BrowserWindow({ show: false, webPreferences: { session: profile, sandbox: true } });
+    await caller.loadURL(`chrome-extension://${ext.id}/page.html`);
+    return { ext, caller, extensionPath };
+  }
+  async function tab(s = profile, target = url) {
+    const w = new BrowserWindow({ show: false, webPreferences: { session: s, sandbox: true } });
+    await w.loadURL(target);
+    return w;
+  }
+  function inject(caller: BrowserWindow, id: number) {
+    return caller.webContents.executeJavaScript(`chrome.scripting.executeScript({target:{tabId:${id}},func:()=>location.href})`);
+  }
+
+  it('grants only the invoked native tab and rejects cross-profile/private targets', async () => {
+    const { ext, caller } = await extension();
+    const first = await tab();
+    const sameOrigin = await tab();
+    const other = await tab(session.fromPartition(`persist:other-${Date.now()}`));
+    const privateTab = await tab(session.fromPartition(`private-${Date.now()}`));
+    await expect(inject(caller, first.webContents.id)).rejects.toThrow();
+    await expect(native(profile).grantZacroActiveTab(ext.id, other.webContents.id)).rejects.toThrow();
+    await expect(native(profile).grantZacroActiveTab(ext.id, privateTab.webContents.id)).rejects.toThrow();
+    await native(profile).grantZacroActiveTab(ext.id, first.webContents.id);
+    expect((await inject(caller, first.webContents.id))[0].result).toBe(url);
+    await expect(inject(caller, sameOrigin.webContents.id)).rejects.toThrow();
+    await expect(first.webContents.executeJavaScript('typeof require')).resolves.toBe('undefined');
+    await expect(caller.webContents.executeJavaScript('typeof require')).resolves.toBe('undefined');
+  });
+
+  it('revokes on cross-origin navigation, destruction and unload', async () => {
+    const { ext, caller, extensionPath } = await extension();
+    const first = await tab();
+    await native(profile).grantZacroActiveTab(ext.id, first.webContents.id);
+    await first.loadURL('about:blank');
+    await expect(inject(caller, first.webContents.id)).rejects.toThrow();
+    await first.loadURL(url);
+    await expect(inject(caller, first.webContents.id)).rejects.toThrow();
+    await native(profile).grantZacroActiveTab(ext.id, first.webContents.id);
+    const oldId = first.webContents.id;
+    first.destroy();
+    await expect(native(profile).grantZacroActiveTab(ext.id, oldId)).rejects.toThrow();
+    const second = await tab();
+    await native(profile).grantZacroActiveTab(ext.id, second.webContents.id);
+    profile.extensions.removeExtension(ext.id);
+    await expect(native(profile).grantZacroActiveTab(ext.id, second.webContents.id)).rejects.toThrow();
+    const reloaded = await profile.extensions.loadExtension(extensionPath);
+    const freshCaller = await tab(profile, `chrome-extension://${reloaded.id}/page.html`);
+    await expect(inject(freshCaller, second.webContents.id)).rejects.toThrow();
+  });

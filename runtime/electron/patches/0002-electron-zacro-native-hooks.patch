+namespace {
+
+// A discarded Chromium callback must reject, rather than leave a native grant
+// promise pending forever. The last owner is released on shutdown/cancellation.
+struct ZacroPermissionUpdate {
+  explicit ZacroPermissionUpdate(v8::Isolate* isolate) : promise(isolate) {}
+  ~ZacroPermissionUpdate() {
+    if (!finished)
+      promise.RejectWithErrorMessage("Permission update cancelled");
+  }
+  void Reject(const std::string& error) {
+    if (!finished) {
+      finished = true;
+      promise.RejectWithErrorMessage(error);
+    }
+  }
+  gin_helper::Promise<void> promise;
+  bool finished = false;
+};
+
+const extensions::Extension* EnabledExtension(content::BrowserContext* context,
+                                              const std::string& id) {
+  if (context->IsOffTheRecord())
+    return nullptr;
+  return extensions::ExtensionRegistry::Get(context)
+      ->enabled_extensions()
+      .GetByID(id);
+}
+
+}  // namespace
+
+base::DictValue Extensions::GetZacroCapabilities() {
+  return base::DictValue()
+      .Set("version", 1)
+      .Set("activeTab", true)
+      .Set("reviewedPermissions", true)
+      .Set("userScripts", true)
+      .Set("fontSettings", true);
+}
+
+v8::Local<v8::Promise> Extensions::GrantZacroActiveTab(
+    v8::Isolate* isolate,
+    const std::string& extension_id,
+    int web_contents_id) {
+  gin_helper::Promise<void> promise(isolate);
+  auto handle = promise.GetHandle();
+  auto* extension = EnabledExtension(browser_context(), extension_id);
+  auto* wrapper = WebContents::FromID(web_contents_id);
+  auto* contents = wrapper ? wrapper->GetWebContents() : nullptr;
+  if (!extension || !contents || contents->IsBeingDestroyed() ||
+      contents->GetBrowserContext() != browser_context() ||
+      !contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS() ||
+      !extension->permissions_data()->HasAPIPermission(
+          extensions::mojom::APIPermissionID::kActiveTab)) {
+    promise.RejectWithErrorMessage(
+        "Invalid activeTab extension, session or tab");
+    return handle;
+  }
+  extensions::ActiveTabPermissionGranter::CreateForWebContents(
+      contents, web_contents_id, browser_context());
+  auto* granter =
+      extensions::ActiveTabPermissionGranter::FromWebContents(contents);
+  granter->GrantIfRequestedWithCallback(
+      extension,
+      base::BindOnce(
+          [](gin_helper::Promise<void> promise, bool granted) {
+            if (granted)
+              promise.Resolve();
+            else
+              promise.RejectWithErrorMessage("activeTab grant cancelled");
+          },
+          std::move(promise)));
+  return handle;
+}
+
+v8::Local<v8::Promise> Extensions::SetZacroReviewedPermissions(
+    v8::Isolate* isolate,
+    const std::string& extension_id,
+    base::DictValue reviewed) {
+  auto operation = std::make_shared<ZacroPermissionUpdate>(isolate);
+  auto handle = operation->promise.GetHandle();
+  scoped_refptr<const extensions::Extension> extension =
+      EnabledExtension(browser_context(), extension_id);
+  if (!extension || pending_permission_updates_.contains(extension_id)) {
+    operation->Reject("Invalid extension or permission update already pending");
+    return handle;
+  }
+  std::string error;
+  auto desired =
+      extensions::ParseZacroReviewedPermissions(*extension, reviewed, &error);
+  if (!desired) {
+    operation->Reject(error);
+    return handle;
+  }
+  if (!desired->HasAPIPermission(
+          extensions::mojom::APIPermissionID::kUserScripts)) {
+    extensions::ExtensionSystem::Get(browser_context())
+        ->user_script_manager()
+        ->SetUserScriptPrefEnabled(extension_id, false);
+  }
+  // A reviewed revocation also invalidates temporary grants. The updater's
+  // forced network barrier below follows all these clear operations, including
+  // when only an API permission (such as optional activeTab) was removed.
+  auto revoked = extensions::PermissionSet::CreateDifference(
+      extension->permissions_data()->active_permissions(), *desired);
+  if (!revoked->IsEmpty()) {
+    for (auto* wrapper : WebContents::GetWebContentsList()) {
+      auto* contents = wrapper->GetWebContents();
+      if (contents && !contents->IsBeingDestroyed() &&
+          contents->GetBrowserContext() == browser_context()) {
+        if (auto* granter =
+                extensions::ActiveTabPermissionGranter::FromWebContents(
+                    contents))
+          granter->ClearActiveExtensionAndNotify(extension_id);
+      }
+    }
+  }
+  pending_permission_updates_.insert(extension_id);
+  auto weak = weak_factory_.GetWeakPtr();
+  auto context =
+      static_cast<ElectronBrowserContext*>(browser_context())->GetWeakPtr();
+  auto cleanup = std::make_shared<base::ScopedClosureRunner>(base::BindOnce(
+      [](base::WeakPtr<Extensions> self, const std::string& id) {
+        if (self)
+          self->pending_permission_updates_.erase(id);
+      },
+      weak, extension_id));
+  extensions::PermissionsUpdater(browser_context())
+      .SetZacroReviewedPermissions(
+          *extension, *desired,
+          base::BindOnce(
+              [](base::WeakPtr<ElectronBrowserContext> context,
+                 scoped_refptr<const extensions::Extension> extension,
+                 std::shared_ptr<ZacroPermissionUpdate> operation,
+                 std::shared_ptr<base::ScopedClosureRunner> cleanup) {
+                if (!context ||
+                    EnabledExtension(context.get(), extension->id()) !=
+                        extension.get()) {
+                  operation->Reject(
+                      "Extension unloaded during permission update");
+                  return;
+                }
+                context->prefs()->CommitPendingWrite(base::BindOnce(
+                    [](base::WeakPtr<ElectronBrowserContext> context,
+                       scoped_refptr<const extensions::Extension> extension,
+                       std::shared_ptr<ZacroPermissionUpdate> operation,
+                       std::shared_ptr<base::ScopedClosureRunner> cleanup) {
+                      if (!context ||
+                          EnabledExtension(context.get(), extension->id()) !=
+                              extension.get()) {
+                        operation->Reject(
+                            "Extension unloaded during permission persistence");
+                        return;
+                      }
+                      cleanup->RunAndReset();
+                      operation->finished = true;
+                      operation->promise.Resolve();
+                    },
+                    context, extension, operation, cleanup));
+              },
+              context, extension, operation, cleanup));
+  return handle;
+}
+
+void Extensions::SetZacroUserScriptsEnabled(gin::Arguments* args,
+                                            const std::string& extension_id,
+                                            bool enabled) {
+  auto* extension = EnabledExtension(browser_context(), extension_id);
+  if (!extension ||
+      (enabled && !extension->permissions_data()->HasAPIPermission(
+                      extensions::mojom::APIPermissionID::kUserScripts))) {
+    args->ThrowError("Invalid extension or userScripts not declared");
+    return;
+  }
+  extensions::ExtensionSystem::Get(browser_context())
+      ->user_script_manager()
+      ->SetUserScriptPrefEnabled(extension_id, enabled);
+}
+
+void Extensions::SetZacroFontPreferences(gin::Arguments* args,
+                                         base::DictValue overrides) {
+  static const std::set<std::string> families = {
+      "standard", "serif", "sansserif", "fixed", "cursive", "fantasy", "math"};
+  static const std::set<std::string> sizes = {
+      "defaultFontSize", "defaultFixedFontSize", "minimumFontSize"};
+  bool valid = overrides.size() <= 4;
+  for (const auto item : overrides) {
+    if (item.first == "fonts") {
+      if (!item.second.is_list() || item.second.GetList().size() > 2048) {
+        valid = false;
+        break;
+      }
+      std::set<std::string> keys;
+      for (const auto& font : item.second.GetList()) {
+        if (!font.is_dict()) {
+          valid = false;
+          break;
+        }
+        const auto& dict = font.GetDict();
+        const auto* script = dict.FindString("script");
+        const auto* family = dict.FindString("genericFamily");
+        const auto* name = dict.FindString("fontId");
+        UScriptCode code;
+        UErrorCode status = U_ZERO_ERROR;
+        if (dict.size() != 3 || !script || script->size() != 4 || !family ||
+            !name || !families.contains(*family) || name->size() > 256 ||
+            name->find('\0') != std::string::npos ||
+            uscript_getCode(script->c_str(), &code, 1, &status) != 1 ||
+            U_FAILURE(status) || *script != uscript_getShortName(code) ||
+            !keys.insert(*script + ":" + *family).second) {
+          valid = false;
+          break;
+        }
+      }
+    } else if (!sizes.contains(item.first) || !item.second.is_int() ||
+               item.second.GetInt() <
+                   (item.first == "minimumFontSize" ? 0 : 1) ||
+               item.second.GetInt() > 512) {
+      valid = false;
+    }
+  }
+  if (!valid) {
+    args->ThrowError("Invalid native font preference map");
+    return;
+  }
+  static_cast<ElectronBrowserContext*>(browser_context())
+      ->SetZacroFontPreferences(std::move(overrides));
+  for (auto* wrapper : WebContents::GetWebContentsList()) {
+    auto* contents = wrapper->GetWebContents();
+    if (contents && !contents->IsBeingDestroyed() &&
+        contents->GetBrowserContext() == browser_context())
+      contents->OnWebPreferencesChanged();
+  }
+}
+
+base::DictValue Extensions::GetZacroFontPreferences() {
+  blink::web_pref::WebPreferences prefs;
+  SetFontDefaults(&prefs);
+  ApplyZacroFontPreferences(
+      &prefs, static_cast<ElectronBrowserContext*>(browser_context())
+                  ->zacro_font_preferences());
+  base::ListValue fonts;
+  auto append = [&fonts](const char* family,
+                         const blink::web_pref::ScriptFontFamilyMap& map) {
+    for (const auto& [script, name] : map) {
+      fonts.Append(base::DictValue()
+                       .Set("script", script)
+                       .Set("genericFamily", family)
+                       .Set("fontId", base::UTF16ToUTF8(name)));
+    }
+  };
+  append("standard", prefs.standard_font_family_map);
+  append("serif", prefs.serif_font_family_map);
+  append("sansserif", prefs.sans_serif_font_family_map);
+  append("fixed", prefs.fixed_font_family_map);
+  append("cursive", prefs.cursive_font_family_map);
+  append("fantasy", prefs.fantasy_font_family_map);
+  append("math", prefs.math_font_family_map);
+  return base::DictValue()
+      .Set("fonts", std::move(fonts))
+      .Set("defaultFontSize", prefs.default_font_size)
+      .Set("defaultFixedFontSize", prefs.default_fixed_font_size)
+      .Set("minimumFontSize", prefs.minimum_font_size);
+}
+
+v8::Local<v8::Promise> Extensions::GetZacroFontList(v8::Isolate* isolate) {
+  gin_helper::Promise<base::ListValue> promise(isolate);
+  auto handle = promise.GetHandle();
+  content::GetFontListAsync(base::BindOnce(
+      [](gin_helper::Promise<base::ListValue> promise, base::ListValue fonts) {
+        base::ListValue result;
+        for (const auto& font : fonts) {
+          if (font.is_list() && font.GetList().size() >= 2 &&
+              font.GetList()[0].is_string() && font.GetList()[1].is_string()) {
+            result.Append(
+                base::DictValue()
+                    .Set("fontId", font.GetList()[0].GetString())
+                    .Set("displayName", font.GetList()[1].GetString()));
+          }
+        }
+        promise.Resolve(std::move(result));
+      },
+      std::move(promise)));
+  return handle;
+}

+    const { ext } = await extension();
+    const first = await tab();
+    const granting = native(profile).grantZacroActiveTab(ext.id, first.webContents.id);
+    first.destroy();
+    await expect(granting).rejects.toThrow(/cancelled/);
+  });
+
+  it('rejects an extension that did not declare activeTab and internal pages', async () => {
+    const { ext } = await extension(['scripting']);
+    const first = await tab();
+    await expect(native(profile).grantZacroActiveTab(ext.id, first.webContents.id)).rejects.toThrow();
+    const { ext: allowed } = await extension();
+    const blank = await tab(profile, 'about:blank');
+    await expect(native(profile).grantZacroActiveTab(allowed.id, blank.webContents.id)).rejects.toThrow();
+  });
+
+  it('updates reviewed rights in the living caller and blocks native review bypass', async () => {
+    const { ext, caller } = await extension();
+    const id = caller.webContents.id;
+    await expect(caller.webContents.executeJavaScript('chrome.permissions.request({permissions:["storage"]})', true)).rejects.toThrow(/not supported/);
+    const before = await caller.webContents.executeJavaScript('chrome.permissions.contains({permissions:["storage"]})');
+    expect(before).toBe(false);
+    await caller.webContents.executeJavaScript('window.aliveMarker = 1701');
+    await native(profile).setZacroReviewedPermissions(ext.id, {
+      permissions: ['activeTab', 'scripting', 'storage'], origins: ['http://127.0.0.1/*']
+    });
+    expect(caller.webContents.id).toBe(id);
+    expect(await caller.webContents.executeJavaScript('window.aliveMarker')).toBe(1701);
+    expect(await caller.webContents.executeJavaScript('chrome.permissions.contains({permissions:["storage"]})')).toBe(true);
+    const first = await tab();
+    expect((await inject(caller, first.webContents.id))[0].result).toBe(url);

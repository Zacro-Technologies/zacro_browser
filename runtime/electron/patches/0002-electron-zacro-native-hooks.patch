diff --git a/spec/fixtures/api/zacro-native-restart.cjs b/spec/fixtures/api/zacro-native-restart.cjs
new file mode 100644
index 0000000..a878327
--- /dev/null
+++ b/spec/fixtures/api/zacro-native-restart.cjs
@@ -0,0 +1,33 @@
+const { app, BrowserWindow, session } = require('electron');
+const [userData, extensionPath, target, phase] = process.argv.slice(2);
+app.setPath('userData', userData);
+const timeout = setTimeout(() => { console.error('Restart test timed out'); app.exit(1); }, 30000);
+app.whenReady().then(async () => {
+  const profile = session.fromPartition('persist:restart');
+  const extension = await profile.extensions.loadExtension(extensionPath, {
+    zacroReviewedPermissions: { permissions: ['userScripts'], origins: ['http://127.0.0.1/*'] },
+    zacroUserScriptsEnabled: phase !== 'disabled'
+  });
+  const caller = new BrowserWindow({ show: false, webPreferences: { session: profile, sandbox: true } });
+  await caller.loadURL(`chrome-extension://${extension.id}/page.html`);
+  if (phase === 'register') {
+    profile.extensions.setZacroUserScriptsEnabled(extension.id, true);
+    await caller.webContents.executeJavaScript(`chrome.userScripts.register([{id:'restart',matches:['http://127.0.0.1/*'],js:[{code:"document.documentElement.dataset.restart = 'persisted'"}],runAt:'document_end',world:'USER_SCRIPT'}])`);
+  } else {
+    if (phase === 'disabled') {
+      const disabledWindow = new BrowserWindow({ show: false, webPreferences: { session: profile, sandbox: true } });
+      await disabledWindow.loadURL(target);
+      if (await disabledWindow.webContents.executeJavaScript('document.documentElement.dataset.restart') !== undefined) throw new Error('Stale consent executed a user script before initialization');
+      profile.extensions.setZacroUserScriptsEnabled(extension.id, true);
+    }
+    const registered = await caller.webContents.executeJavaScript('chrome.userScripts.getScripts()');
+    if (!registered.some(script => script.id === 'restart')) throw new Error('Registration lost on restart');
+    const targetWindow = new BrowserWindow({ show: false, webPreferences: { session: profile, sandbox: true } });
+    await targetWindow.loadURL(target);
+    if (await targetWindow.webContents.executeJavaScript('document.documentElement.dataset.restart') !== 'persisted') throw new Error('Persisted user script did not execute');
+  }
+  console.log(`ZACRO_RESTART_${phase}_OK`);
+  clearTimeout(timeout);
+  // Normal shutdown flushes profile prefs and the dynamic script state store.
+  app.quit();
+}).catch(error => { console.error(error); app.exit(1); });

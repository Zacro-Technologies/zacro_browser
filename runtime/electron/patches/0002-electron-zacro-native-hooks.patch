@@ -312,4 +312,36 @@ void SetFontDefaults(blink::web_pref::WebPreferences* prefs) {
   copy_default_fonts_to_web_prefs(prefs);
 }
 
+void ApplyZacroFontPreferences(blink::web_pref::WebPreferences* prefs,
+                               const base::DictValue& overrides) {
+  if (const auto* fonts = overrides.FindList("fonts")) {
+    for (const auto& font : *fonts) {
+      const auto& value = font.GetDict();
+      const auto& script = *value.FindString("script");
+      const auto& family = *value.FindString("genericFamily");
+      const auto name = base::UTF8ToUTF16(*value.FindString("fontId"));
+      if (family == "standard")
+        prefs->standard_font_family_map[script] = name;
+      else if (family == "serif")
+        prefs->serif_font_family_map[script] = name;
+      else if (family == "sansserif")
+        prefs->sans_serif_font_family_map[script] = name;
+      else if (family == "fixed")
+        prefs->fixed_font_family_map[script] = name;
+      else if (family == "cursive")
+        prefs->cursive_font_family_map[script] = name;
+      else if (family == "fantasy")
+        prefs->fantasy_font_family_map[script] = name;
+      else if (family == "math")
+        prefs->math_font_family_map[script] = name;
+    }
+  }
+  if (auto size = overrides.FindInt("defaultFontSize"))
+    prefs->default_font_size = *size;
+  if (auto size = overrides.FindInt("defaultFixedFontSize"))
+    prefs->default_fixed_font_size = *size;
+  if (auto size = overrides.FindInt("minimumFontSize"))
+    prefs->minimum_font_size = *size;
+}
+
 }  // namespace electron

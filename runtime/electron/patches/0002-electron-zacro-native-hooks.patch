+    await expect(inject(caller, first.webContents.id)).rejects.toThrow();
+    expect(await caller.webContents.executeJavaScript('chrome.permissions.contains({permissions:["storage"]})')).toBe(false);
+    await expect(native(profile).setZacroReviewedPermissions(ext.id, { permissions: ['debugger'], origins: [] })).rejects.toThrow();
+  });
+
+  it('retains required hosts when revoking a broader optional origin', async () => {
+    const { ext, caller } = await extension(['scripting'], ['http://127.0.0.1/*']);
+    await native(profile).setZacroReviewedPermissions(ext.id, { permissions: ['scripting'], origins: ['http://*/*'] });
+    await native(profile).setZacroReviewedPermissions(ext.id, { permissions: ['scripting'], origins: ['http://127.0.0.1/*'] });
+    const first = await tab();
+    expect((await inject(caller, first.webContents.id))[0].result).toBe(url);
+  });
+
+  it('replaces persisted optional grants before the next load activates', async () => {
+    const { ext, extensionPath } = await extension();
+    await native(profile).setZacroReviewedPermissions(ext.id, { permissions: ['activeTab', 'scripting', 'storage'], origins: [] });
+    profile.extensions.removeExtension(ext.id);
+    await profile.extensions.loadExtension(extensionPath, {
+      allowFileAccess: false,
+      zacroReviewedPermissions: { permissions: ['activeTab', 'scripting'], origins: [] }
+    } as Electron.LoadExtensionOptions);
+    const caller = await tab(profile, `chrome-extension://${ext.id}/page.html`);
+    expect(await caller.webContents.executeJavaScript('chrome.permissions.contains({permissions:["storage"]})')).toBe(false);
+  });
+

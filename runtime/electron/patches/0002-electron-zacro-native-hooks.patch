+std::unique_ptr<PermissionSet> ParseZacroReviewedPermissions(
+    const Extension& extension,
+    const base::DictValue& value,
+    std::string* error) {
+  const auto* names = value.FindList("permissions");
+  const auto* origins = value.FindList("origins");
+  if (!names || !origins || names->size() > 256 || origins->size() > 1024 ||
+      value.size() != 2) {
+    *error = "Expected bounded permissions and origins arrays";
+    return nullptr;
+  }
+  for (const auto& name : *names) {
+    if (!name.is_string() || name.GetString().size() > 128) {
+      *error = "Invalid API permission";
+      return nullptr;
+    }
+  }
+  APIPermissionSet apis;
+  std::u16string parse_error;
+  std::vector<std::string> unhandled;
+  if (!APIPermissionSet::ParseFromJSON(
+          *names, APIPermissionSet::kDisallowInternalPermissions, &apis,
+          &parse_error, &unhandled) ||
+      !unhandled.empty()) {
+    *error = "Unknown or internal API permission";
+    return nullptr;
+  }
+  URLPatternSet hosts;
+  for (const auto& origin : *origins) {
+    URLPattern pattern(Extension::kValidHostPermissionSchemes);
+    if (!origin.is_string() || origin.GetString().size() > 4096 ||
+        pattern.Parse(origin.GetString()) !=
+            URLPattern::ParseResult::kSuccess) {
+      *error = "Invalid host permission";
+      return nullptr;
+    }
+    hosts.AddPattern(pattern);
+  }
+  const auto& required = PermissionsParser::GetRequiredPermissions(&extension);
+  const auto& optional = PermissionsParser::GetOptionalPermissions(&extension);
+  auto requested = std::make_unique<PermissionSet>(
+      std::move(apis), required.manifest_permissions().Clone(),
+      std::move(hosts), required.scriptable_hosts().Clone());
+  auto declared = PermissionSet::CreateUnion(required, optional);
+  if (!declared->Contains(*requested) || !requested->Contains(required)) {
+    *error =
+        "Reviewed permissions must contain required and stay within declared "
+        "permissions";
+    return nullptr;
+  }
+  return requested;
+}
+
+void SeedZacroReviewedPermissions(content::BrowserContext* context,
+                                  const Extension& extension,
+                                  const PermissionSet& permissions) {
+  auto* prefs = ExtensionPrefs::Get(context);
+  if (auto old = prefs->GetGrantedPermissions(extension.id()))
+    prefs->RemoveGrantedPermissions(extension.id(), *old);
+  if (auto old = prefs->GetRuntimeGrantedPermissions(extension.id()))
+    prefs->RemoveRuntimeGrantedPermissions(extension.id(), *old);
+  prefs->SetDesiredActivePermissions(extension.id(), permissions);
+  prefs->AddGrantedPermissions(extension.id(), permissions);
+  prefs->AddRuntimeGrantedPermissions(extension.id(), permissions);
+  // Initialize before AddExtension can start a worker or inject a script.
+  PermissionsUpdater(context).InitializePermissions(&extension);
+}

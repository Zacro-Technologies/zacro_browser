+void PermissionsUpdater::SetZacroReviewedPermissions(
+    const Extension& extension,
+    const PermissionSet& permissions,
+    base::OnceClosure completion_callback) {
+  const auto& required = PermissionsParser::GetRequiredPermissions(&extension);
+  auto declared = PermissionSet::CreateUnion(
+      required, PermissionsParser::GetOptionalPermissions(&extension));
+  CHECK(permissions.Contains(required));
+  CHECK(declared->Contains(permissions));
+  auto removed = PermissionSet::CreateDifference(
+      extension.permissions_data()->active_permissions(), permissions);
+  auto added = PermissionSet::CreateDifference(
+      permissions, extension.permissions_data()->active_permissions());
+
+  auto* prefs = ExtensionPrefs::Get(browser_context_);
+  if (auto old = prefs->GetGrantedPermissions(extension.id()))
+    prefs->RemoveGrantedPermissions(extension.id(), *old);
+  if (auto old = prefs->GetRuntimeGrantedPermissions(extension.id()))
+    prefs->RemoveRuntimeGrantedPermissions(extension.id(), *old);
+  prefs->SetDesiredActivePermissions(extension.id(), permissions);
+  prefs->AddGrantedPermissions(extension.id(), permissions);
+  prefs->AddRuntimeGrantedPermissions(extension.id(), permissions);
+  SetPermissions(&extension, permissions.Clone(), true);
+
+  // Both notifications observe the same final permission state. In particular,
+  // broad optional origins minus narrower grants must never be applied as a
+  // destructive set subtraction to required hosts. The network and renderer
+  // barrier is completed for each event before replying to the host.
+  NetworkPermissionsUpdateHelper::UpdatePermissions(
+      browser_context_, EventType::kRemoved, &extension, *removed,
+      base::BindOnce(
+          [](content::BrowserContext* context,
+             scoped_refptr<const Extension> extension,
+             std::unique_ptr<PermissionSet> added,
+             base::OnceClosure completion_callback) {
+            // NetworkPermissionsUpdateHelper only invokes callbacks while the
+            // context is alive. Never notify for an unloaded/replaced object.
+            if (ExtensionRegistry::Get(context)->enabled_extensions().GetByID(
+                    extension->id()) != extension.get()) {
+              return;
+            }
+            NetworkPermissionsUpdateHelper::UpdatePermissions(
+                context, EventType::kAdded, extension, *added,
+                std::move(completion_callback));
+          },
+          browser_context_, base::WrapRefCounted(&extension), std::move(added),
+          std::move(completion_callback)),
+      /*force_network_update=*/true);
+}

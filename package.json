{
  "name": "zacro-browser",
  "version": "0.10.2",
  "description": "A sidebar-first Chromium browser with Spaces, profiles, Peek, and optional AI.",
  "main": "src/main/main.cjs",
  "private": true,
  "author": "Zacro Technologies",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/build-native-mac.cjs",
    "prestart": "node scripts/build-native-mac.cjs",
    "start": "electron .",
    "predev": "node scripts/build-native-mac.cjs",
    "dev": "electron .",
    "icons": "electron scripts/generate-icons.cjs",
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check.cjs",
    "format": "prettier --write \"src/**/*.{cjs,js,html,css}\" \"test/**/*.cjs\" \"scripts/*.cjs\" \"services/**/*.cjs\" \"*.json\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{cjs,js,html,css}\" \"test/**/*.cjs\" \"scripts/*.cjs\" \"services/**/*.cjs\" \"*.json\" \".github/**/*.{yml,yaml}\"",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.cjs",
    "test:package": "node --test test/package/*.test.cjs",
    "verify": "npm run format:check && npm run check && npm test && npm run test:e2e",
    "pack": "electron-builder --dir",
    "prepack": "node scripts/prepare-runtime.cjs",
    "pack:mac": "node scripts/build-mac.cjs --dir",
    "dist:mac": "node scripts/build-mac.cjs",
    "test:mac": "node --test --test-concurrency=1 test/e2e/mac.test.cjs test/e2e/ai-connections.test.cjs test/e2e/ai-workflow.test.cjs test/e2e/pinned-lifecycle.test.cjs test/e2e/persistent-split.test.cjs test/e2e/split-interactions.test.cjs test/e2e/copy-image.test.cjs test/e2e/personalization.test.cjs test/e2e/command-workflow.test.cjs test/e2e/browser.test.cjs test/e2e/compact-layout.test.cjs test/e2e/platform-shell.test.cjs test/e2e/motion.test.cjs test/e2e/space-swipe.test.cjs test/e2e/security.test.cjs test/e2e/startup.test.cjs test/e2e/onboarding.test.cjs test/e2e/window-material.test.cjs test/e2e/pin-model.test.cjs test/e2e/library.test.cjs test/e2e/chrome-resize.test.cjs test/e2e/auto-archive.test.cjs test/e2e/extension-*.test.cjs test/e2e/extensions-sync.test.cjs",
    "dist": "electron-builder --win nsis --x64",
    "predist": "node scripts/prepare-runtime.cjs",
    "dist:release": "node scripts/release.cjs",
    "test:interactive": "node scripts/interactive-qa.cjs",
    "test:soak": "node --test test/soak/*.test.cjs",
    "test:provider": "node --test test/provider/*.test.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "prettier": "3.9.10"
  },
  "build": {
    "appId": "com.zacro.browser",
    "productName": "Zacro",
    "asar": true,
    "asarUnpack": [
      "src/native/*.node",
      "node_modules/@openai/codex-*/vendor/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "beforePack": "scripts/validate-package-target.cjs",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Zacro-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "artifactName": "Zacro-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.inherit.plist",
      "notarize": true,
      "extendInfo": {
        "NSCameraUsageDescription": "Allow websites you approve in Zacro to use your camera.",
        "NSMicrophoneUsageDescription": "Allow websites you approve in Zacro to use your microphone.",
        "NSLocationUsageDescription": "Allow websites you approve in Zacro to use your location.",
        "NSLocationWhenInUseUsageDescription": "Allow websites you approve in Zacro to use your location.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web addresses",
            "CFBundleURLRole": "Viewer",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ],
            "LSHandlerRank": "Alternate"
          }
        ]
      }
    },
    "dmg": {
      "title": "Zacro ${version}",
      "icon": "assets/icon.icns",
      "sign": true,
      "contents": [
        {
          "x": 140,
          "y": 160
        },
        {
          "x": 420,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 340
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Network;WebBrowser"
    }
  },
  "dependencies": {
    "@openai/codex": "0.164.0",
    "parse5": "7.3.0",
    "pdfjs-dist": "6.4.299",
    "yauzl": "3.4.0"
  }
}

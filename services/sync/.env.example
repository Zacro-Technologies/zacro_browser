# Explicit operator configuration; the CLI does not auto-load this file.
ZACRO_SYNC_DATA=/srv/zacro-sync/data
ZACRO_SYNC_MASTER_KEY_FILE=/run/secrets/zacro-sync-master
ZACRO_SYNC_HOST=127.0.0.1
ZACRO_SYNC_PORT=4040
# Choose production direct TLS or an explicitly trusted local TLS proxy.
# ZACRO_SYNC_TLS_KEY_FILE=/run/secrets/tls-key
# ZACRO_SYNC_TLS_CERT_FILE=/run/secrets/tls-certificate
# ZACRO_SYNC_TRUSTED_PROXY=1
# ZACRO_SYNC_PUBLIC_URL=https://YOUR-OPERATOR-DOMAIN
# Local development only (numeric loopback remains mandatory):
# ZACRO_SYNC_DEV_LOOPBACK=1

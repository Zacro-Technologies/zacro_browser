# Copy outside the checkout. Pass this persistent file with --env-file.
# Shell-compatible values only. These are paths/names, never secret contents.
ZACRO_SYNC_DOMAIN=
ZACRO_SYNC_IMAGE=zacro-sync:local
ZACRO_SYNC_PROXY_IMAGE=zacro-sync-proxy:local
ZACRO_SYNC_ACTIVE_VOLUME=zacro-sync-live
ZACRO_SYNC_ACTIVE_DATA_DIR=/data
# Record the previous active pair here before every recovery cutover.
ZACRO_SYNC_ROLLBACK_VOLUME=
ZACRO_SYNC_ROLLBACK_DATA_DIR=
ZACRO_SYNC_KEYS_VOLUME=zacro-sync-private-keys
ZACRO_SYNC_BACKUPS_VOLUME=zacro-sync-backups
# Public HTTP is only the ACME challenge / HTTPS redirect listener.
ZACRO_SYNC_HTTP_BIND=80:80
ZACRO_SYNC_HTTPS_BIND=443:443
